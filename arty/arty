  </div>
</header>

<main class="wrap">
  <section class="view" id="view-inbox" role="tabpanel" aria-labelledby="tab-inbox"></section>
  <section class="view" id="view-maps" role="tabpanel" aria-labelledby="tab-maps" hidden></section>
  <section class="view" id="view-reports" role="tabpanel" aria-labelledby="tab-reports" hidden></section>
  <section class="view" id="view-history" role="tabpanel" aria-labelledby="tab-history" hidden></section>
</main>

<div class="toasts" id="toasts" aria-live="polite"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.1/mermaid.min.js"></script>
<script>
"use strict";
/* The console reads its whole world from the database: every project-specific
   fact is a row. Nothing below tests a project by name. */
const COLLECTIONS = ["proposals", "maps", "reports", "records"];
const CLAIMS = ["verified", "partial", "unverified", "planned"];
const CLAIM_TONE = {verified: "success", partial: "warning", unverified: "neutral", planned: "info"};
const URGENCY_RANK = {blocking: 0, soon: 1, whenever: 2};
const ARTY = {
  proposals: "arty: file a proposal from a session that needs a judgement call",
  maps: "arty sync --db DUMP --plan DIR",
  reports: "arty: register a report when an analysis is published",
  records: "arty sync --db DUMP --plan DIR"
};

const state = {project: null, view: "inbox", canEdit: false, db: null, ready: false};
COLLECTIONS.forEach(c => state[c] = []);
const el = id => document.getElementById(id);
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

/* —— formatting —— */
function fmtDate(v) {
  if (!v) return "";
  const d = new Date(v);
  if (isNaN(d)) return String(v);
  return d.toLocaleDateString("en-GB", {day: "numeric", month: "short", year: "numeric"});
}
function ago(v) {
  if (!v) return "";
  const days = Math.floor((Date.now() - new Date(v).getTime()) / 86400000);
  if (isNaN(days)) return "";
  if (days <= 0) return "today";
  if (days === 1) return "yesterday";
  return days + " days ago";
}
function badge(text, tone, opts) {
  const o = opts || {};
  const cls = ["badge"];
  if (tone && tone !== "neutral") cls.push("badge--" + tone);
  if (o.pulse) cls.push("badge--pulse");
  return '<span class="' + cls.join(" ") + '">' + (o.dot || o.pulse ? '<i class="dot"></i>' : "") + esc(text) + "</span>";
}
function tags(anchors) {
  if (!anchors || !anchors.length) return "";
  return '<span class="tags">' + anchors.map(a => '<span class="tag">' + esc(a) + "</span>").join("") + "</span>";
}

/* —— a small markdown subset: agent-authored evidence, escaped first —— */
function md(src) {
  if (!src) return "";
  const blocks = [];
  String(src).split(/\n{2,}/).forEach(raw => {
    const b = raw.trim();
    if (!b) return;
    if (/^###?\s/.test(b)) { blocks.push("<h3>" + inline(b.replace(/^#+\s*/, "")) + "</h3>"); return; }
    if (/^([-*]\s)/m.test(b) && b.split("\n").every(l => /^[-*]\s/.test(l.trim()))) {
      blocks.push("<ul>" + b.split("\n").map(l => "<li>" + inline(l.trim().replace(/^[-*]\s*/, "")) + "</li>").join("") + "</ul>");
      return;
    }
    blocks.push("<p>" + inline(b) + "</p>");
  });
  return '<div class="md">' + blocks.join("") + "</div>";
}
function inline(s) {
  return esc(s)
    .replace(/`([^`]+)`/g, (m, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/(^|[\s(])\*([^*]+)\*/g, "$1<em>$2</em>")
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1 <span class="ext">&#8599;</span></a>')
    .replace(/\n/g, " ");
}
function diff(d) {
  const lines = String(d.patch || "").split("\n").map(l => {
    const cls = l.startsWith("+") ? "add" : l.startsWith("-") ? "del" : l.startsWith("@@") ? "hunk" : "";
    return "<b" + (cls ? ' class="' + cls + '"' : "") + ">" + esc(l || " ") + "</b>";
  }).join("");
  return '<div class="diff">' + (d.path ? '<div class="diff__p">' + esc(d.path) + "</div>" : "") + "<pre>" + lines + "</pre></div>";
}
function evidence(ev) {
  if (!ev) return "";
  const parts = [];
  if (ev.markdown) parts.push(md(ev.markdown));
  if (ev.mermaid) parts.push('<pre class="mermaid">' + esc(ev.mermaid) + "</pre>");
  (ev.diffs || []).forEach(d => parts.push(diff(d)));
  (ev.exhibits || []).forEach(u => parts.push('<div class="meta"><a href="' + esc(u) + '" target="_blank" rel="noopener">' + esc(u) + ' <span class="ext">&#8599;</span></a></div>'));
  if (!parts.length) return "";
  return '<details class="ev"><summary>Evidence</summary><div class="ev__body">' + parts.join("") + "</div></details>";
}

/* —— mermaid, themed to Sobar. Hex only: the library cannot parse oklch(). —— */
function diagramTheme() {
  const ink = isDark();
  return {
    startOnLoad: false, securityLevel: "strict", fontFamily: '"Fira Code",monospace', fontSize: 12,
    theme: "base",
    themeVariables: ink
      ? {background: "#1F1A16", primaryColor: "#2C2520", primaryTextColor: "#F8F3EA", primaryBorderColor: "#8C8378",
         lineColor: "#E0603C", secondaryColor: "#332A22", tertiaryColor: "#241E19", textColor: "#F8F3EA"}
      : {background: "#F2EDE3", primaryColor: "#FDFBF7", primaryTextColor: "#231C17", primaryBorderColor: "#8C8378",
         lineColor: "#B63E20", secondaryColor: "#F8F3EA", tertiaryColor: "#F2EDE3", textColor: "#231C17"}
  };
}
function isDark() {
  const stamped = document.documentElement.getAttribute("data-theme");
  if (stamped === "dark") return true;
  if (stamped === "light") return false;
  return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
}
let diagramSeq = 0;
function drawDiagrams(scope) {
  if (typeof mermaid === "undefined") return;
  const nodes = [...scope.querySelectorAll("pre.mermaid")].filter(n => !n.dataset.drawn);
  if (!nodes.length) return;
  nodes.forEach(n => { n.dataset.drawn = "1"; n.dataset.src = n.dataset.src || n.textContent; n.id = "mmd-" + (++diagramSeq); });
  try {
    mermaid.initialize(diagramTheme());
    mermaid.run({nodes: nodes, suppressErrors: true});
  } catch (e) { /* the source stays readable as code */ }
}
function redrawDiagrams() {
  document.querySelectorAll("pre.mermaid[data-src]").forEach(n => {
    n.removeAttribute("data-processed"); n.removeAttribute("data-drawn"); n.textContent = n.dataset.src;
  });
  drawDiagrams(document);
}

/* —— relations: hovering one thing shows what it touches —— */
function wireRelations(scope) {
  const items = [...scope.querySelectorAll("[data-anchors]")];
  if (items.length < 2) return;
  const anchorsOf = node => { try { return JSON.parse(node.dataset.anchors || "[]"); } catch (e) { return []; } };
  items.forEach(node => {
    const mine = anchorsOf(node);
    if (!mine.length) return;
    node.addEventListener("mouseenter", () => {
      const set = new Set(mine);
      items.forEach(other => {
        if (other === node) return;
        const hit = anchorsOf(other).some(a => set.has(a));
        other.classList.toggle("is-related", hit);
        other.classList.toggle("is-dim", !hit);
      });
      scope.querySelectorAll(".tag").forEach(t => t.classList.toggle("tag--related", set.has(t.textContent)));
    });
    node.addEventListener("mouseleave", () => {
      items.forEach(o => o.classList.remove("is-related", "is-dim"));
      scope.querySelectorAll(".tag--related").forEach(t => t.classList.remove("tag--related"));
    });
  });
}

/* —— views —— */
function emptyState(kind, line) {
  return '<div class="empty"><p>' + esc(line) + "</p><code>" + esc(ARTY[kind]) + "</code></div>";
}

function keep(view) {
  const draft = {notes: {}, picked: {}, open: []};
  view.querySelectorAll("textarea").forEach(t => { if (t.value) draft.notes[t.id] = t.value; });
  view.querySelectorAll("input[type=radio]:checked").forEach(r => draft.picked[r.name] = r.value);
  view.querySelectorAll("details[open]").forEach(d => draft.open.push(d.querySelector("summary").textContent));
  return draft;
}
function restore(view, draft) {
  Object.keys(draft.notes).forEach(id => { const t = el(id); if (t) t.value = draft.notes[id]; });
  Object.keys(draft.picked).forEach(name => {
    const r = view.querySelector('input[name="' + name + '"][value="' + draft.picked[name] + '"]');
    if (r) r.checked = true;
  });
  view.querySelectorAll("details").forEach(d => {
    if (draft.open.includes(d.querySelector("summary").textContent)) d.open = true;
  });
}

function renderInbox() {
  const view = el("view-inbox");
  const draft = keep(view);
  const open = state.proposals.filter(p => p.status === "open")
    .sort((a, b) => (URGENCY_RANK[a.urgency] ?? 9) - (URGENCY_RANK[b.urgency] ?? 9) || String(b.asked_at || "").localeCompare(String(a.asked_at || "")));
  const answered = state.proposals.filter(p => p.status === "answered");
  const closed = state.proposals.filter(p => ["accepted", "withdrawn", "superseded"].includes(p.status));
  const live = answered.concat(open);
  const html = [];

  if (!live.length) {
    html.push(emptyState("proposals", state.ready ? "Nothing is waiting on you." : "Reading the console…"));
  } else {
    live.forEach((p, i) => html.push(proposalCard(p, i)));
  }
  if (closed.length) {
    html.push('<details class="arch"><summary>' + closed.length + " decided · archived</summary><div class=\"arch__list\">" +
      closed.sort((a, b) => String(b.asked_at || "").localeCompare(String(a.asked_at || ""))).map(p =>
        '<div class="arch__row"><span>' + esc(p.status) + "</span><b>" + esc(p.title || p.id) + "</b><span>" +
        esc((p.outcome && p.outcome.adr) || (p.answer && p.answer.choice) || "") + "</span></div>").join("") +
      "</div></details>");
  }
  view.innerHTML = html.join("");
  restore(view, draft);
  view.querySelectorAll("form[data-proposal]").forEach(wireAnswerForm);
  wireRelations(view);
  drawDiagrams(view);
}

function proposalCard(p, i) {
  const answered = p.status === "answered";
  const options = Array.isArray(p.options) ? p.options : [];
  const chosen = answered && p.answer ? options.find(o => o.key === p.answer.choice) : null;
  const head = [
    '<span class="eyebrow">Decision · № ' + String(i + 1).padStart(2, "0") + "</span>",
    answered
      ? badge("awaiting pickup", "info", {dot: true})
      : badge(p.urgency || "whenever", p.urgency === "blocking" ? "accent" : "neutral", {pulse: p.urgency === "blocking", dot: true})
  ].join("");

  const body = [
    '<div class="card__head">' + head + "</div>",
    '<h2 class="card__title">' + esc(p.title || p.id) + "</h2>",
    p.question ? '<p class="card__q">' + esc(p.question) + "</p>" : "",
    p.assumption ? '<div class="assume"><span class="assume__k">Meanwhile</span><span class="assume__v">' + esc(p.assumption) + "</span></div>" : "",
    evidence(p.evidence)
  ];

  if (answered) {
    body.push('<div class="opts"><div class="opt"><span class="row__i">→</span><div><div class="opt__label">' +
      esc(chosen ? chosen.label : p.answer.choice) + '<span class="rec">your choice</span></div>' +
      (p.answer.notes ? '<div class="opt__sum">' + esc(p.answer.notes) + "</div>" : "") +
      '<div class="opt__trade">answered ' + esc(ago(p.answer.answered_at)) + " · no session has picked it up yet</div></div></div></div>");
  } else if (state.canEdit) {
    body.push('<form data-proposal="' + esc(p.id) + '"><div class="opts">' + options.map((o, n) =>
      '<label class="opt"><input type="radio" name="opt-' + esc(p.id) + '" value="' + esc(o.key) + '" id="opt-' + esc(p.id) + "-" + esc(o.key) + '"' +
      (o.recommended ? " checked" : (n === 0 && !options.some(x => x.recommended) ? " checked" : "")) + '><div>' +
      '<div class="opt__label">' + esc(o.label || o.key) + (o.recommended ? '<span class="rec">recommended</span>' : "") + "</div>" +
      (o.summary ? '<div class="opt__sum">' + esc(o.summary) + "</div>" : "") +
      (o.tradeoffs ? '<div class="opt__trade">' + esc(o.tradeoffs) + "</div>" : "") +
      "</div></label>").join("") + "</div>" +
      '<div class="field" style="margin-top:var(--space-5)"><textarea id="notes-' + esc(p.id) + '" placeholder="Anything the session should know…"></textarea></div>' +
      '<div class="actions" style="margin-top:var(--space-5)"><button class="btn" type="submit"><span>Record decision</span></button>' +
      '<button class="btn btn--ghost" type="button" data-withdraw="' + esc(p.id) + '">No longer matters</button></div></form>');
  } else {
    body.push('<div class="opts">' + options.map(o => '<div class="opt"><span class="row__i">·</span><div><div class="opt__label">' +
      esc(o.label || o.key) + (o.recommended ? '<span class="rec">recommended</span>' : "") + "</div>" +
      (o.summary ? '<div class="opt__sum">' + esc(o.summary) + "</div>" : "") + "</div></div>").join("") + "</div>");
  }

  body.push('<div class="meta">asked ' + esc(ago(p.asked_at)) + (p.asked_by ? " · " + esc(p.asked_by) : "") + "</div>");
  if (p.anchors && p.anchors.length) body.push(tags(p.anchors));

  return '<article class="card' + (p.urgency === "blocking" && !answered ? " card--live" : "") +
    '" data-anchors="' + esc(JSON.stringify(p.anchors || [])) + '" style="animation-delay:' + (i * 60) + 'ms">' +
    body.filter(Boolean).join("") + "</article>";
}

function wireAnswerForm(form) {
  const id = form.dataset.proposal;
  form.addEventListener("submit", e => {
    e.preventDefault();
    const picked = form.querySelector("input[type=radio]:checked");
    if (!picked) return;
    const notes = (el("notes-" + id) || {}).value || "";
    const btn = form.querySelector("button[type=submit]");
    btn.disabled = true;
    write(id, {
      status: "answered",
      answer: {choice: picked.value, notes: notes.trim(), answered_at: new Date().toISOString()}
    }, "Decision recorded", btn);
  });
  const w = form.querySelector("[data-withdraw]");
  if (w) w.addEventListener("click", () => {
    w.disabled = true;
    write(id, {status: "withdrawn", answer: {choice: "", notes: "No longer matters.", answered_at: new Date().toISOString()}}, "Withdrawn", w);
  });
}

function write(id, patch, ok, btn) {
  if (!state.db) return;
  state.db.doc("proposals/" + id).update(patch)
    .then(() => toast(ok, "The next session picks it up."))
    .catch(err => {
      if (btn) btn.disabled = false;
      toast("Not recorded", (err && (err.message || err.code)) || "The write was refused.", "warning");
    });
}

function renderMaps() {
  const view = el("view-maps");
  const live = state.maps.filter(m => m.status !== "retired")
    .sort((a, b) => (a.status === "stale" ? 0 : 1) - (b.status === "stale" ? 0 : 1) || String(a.title || "").localeCompare(String(b.title || "")));
  const retired = state.maps.filter(m => m.status === "retired");
  const html = [];
  if (!live.length) {
    html.push(emptyState("maps", state.ready ? "No maps are registered." : "Reading the console…"));
  } else {
    html.push('<div class="index">' + live.map((m, i) => mapRow(m, i)).join("") + "</div>");
  }
  if (retired.length) html.push(archive(retired, "retired"));
  view.innerHTML = html.join("");
  wireRelations(view);
}

function mapRow(m, i) {
  const stale = m.status === "stale";
  const counts = m.claims || {};
  const total = CLAIMS.reduce((n, k) => n + (Number(counts[k]) || 0), 0);
  const bar = total
    ? '<div class="bar">' + CLAIMS.map(k => {
        const n = Number(counts[k]) || 0;
        return n ? '<span class="s-' + k + '" style="width:' + (n / total * 100) + '%"></span>' : "";
      }).join("") + "</div>" +
      '<div class="legend">' + CLAIMS.filter(k => Number(counts[k])).map(k =>
        '<span><i style="background:' + (k === "unverified" ? "var(--stone-400)" : "var(--" + CLAIM_TONE[k] + ")") + '"></i>' +
        counts[k] + " " + k + "</span>").join("") + "</div>"
    : '<div class="legend"><span>no claims recorded</span></div>';

  const why = stale && (m.invalidated_by || []).length
    ? '<div class="row__why">' + m.invalidated_by.slice(0, 5).map(c =>
        '<span class="commit"><b>' + esc(c.commit || "") + "</b> " + esc(c.subject || "") + "</span>").join("") +
      (m.invalidated_count > (m.invalidated_by || []).length
        ? '<span class="commit">and ' + (m.invalidated_count - m.invalidated_by.length) + " more</span>" : "") + "</div>"
    : "";

  return '<a class="row" href="' + esc(m.url || "#") + '" target="_blank" rel="noopener" data-anchors="' + esc(JSON.stringify(m.anchors || [])) + '">' +
    '<span class="row__i">' + String(i + 1).padStart(2, "0") + "</span>" +
    '<div class="row__main"><span class="row__t">' + esc(m.title || m.id) + ' <span class="ext">&#8599;</span></span>' +
    (m.purpose ? '<span class="row__sub">' + esc(m.purpose) + "</span>" : "") +
    (m.anchors && m.anchors.length ? tags(m.anchors) : "") + why + "</div>" +
    '<div class="row__side">' + (stale ? badge("stale", "danger", {dot: true}) : badge("current", "success", {dot: true})) +
    '<div class="claims">' + bar + "</div>" +
    '<span class="meta">' + (m.refreshed_at ? "refreshed " + esc(ago(m.refreshed_at)) : "") + "</span></div></a>";
}

function renderReports() {
  const view = el("view-reports");
  const live = state.reports.filter(r => r.status === "current")
    .sort((a, b) => String(b.date || "").localeCompare(String(a.date || "")));
  const done = state.reports.filter(r => r.status !== "current");
  const html = [];
  if (!live.length) {
    html.push(emptyState("reports", state.ready ? "No open questions have a report." : "Reading the console…"));
  } else {
    html.push('<div class="index">' + live.map((r, i) =>
      (r.url ? '<a class="row" href="' + esc(r.url) + '" target="_blank" rel="noopener"' : '<div class="row"') +
      ' data-anchors="' + esc(JSON.stringify(r.anchors || [])) + '">' +
      '<span class="row__i">' + String(i + 1).padStart(2, "0") + "</span>" +
      '<div class="row__main"><span class="row__t">' + esc(r.title || r.id) + (r.url ? ' <span class="ext">&#8599;</span>' : "") + "</span>" +
      (r.question ? '<span class="row__sub">' + esc(r.question) + "</span>" : "") +
      (r.answer ? md(r.answer) : "") + (r.markdown && !r.url ? md(r.markdown) : "") +
      (r.anchors && r.anchors.length ? tags(r.anchors) : "") + "</div>" +
      '<div class="row__side"><span class="meta">' + esc(fmtDate(r.date)) + "</span>" +
      (r.path ? '<span class="meta">' + esc(r.path) + "</span>" : "") + "</div>" +
      (r.url ? "</a>" : "</div>")).join("") + "</div>");
  }
  if (done.length) html.push(archive(done, "settled"));
  view.innerHTML = html.join("");
  wireRelations(view);
  drawDiagrams(view);
}

function renderHistory() {
  const view = el("view-history");
  const live = state.records.filter(r => r.status !== "missing")
    .sort((a, b) => String(b.date || "").localeCompare(String(a.date || "")) || String(b.time || "").localeCompare(String(a.time || "")));
  if (!live.length) {
    view.innerHTML = emptyState("records", state.ready ? "No decisions or changes are recorded yet." : "Reading the console…");
    return;
  }
  const byProposal = {};
  state.proposals.forEach(p => { if (p.outcome && p.outcome.adr) byProposal[p.outcome.adr] = p; });
  view.innerHTML = '<div class="tl">' + live.map(r => {
    const p = byProposal[r.path];
    const tone = r.status === "superseded" ? "warning" : r.status === "stale" ? "neutral" : r.kind === "adr" ? "accent" : "neutral";
    return '<article class="tl__item" data-anchors="' + esc(JSON.stringify((p && p.anchors) || [])) + '">' +
      '<div class="tl__head"><span class="meta">' + esc(fmtDate(r.date)) + "</span>" +
      '<span class="tl__t">' + esc(r.title || r.id) + "</span>" +
      badge(r.kind === "adr" ? "decision" : "change", tone) +
      (r.status === "superseded" ? badge("superseded", "warning") : "") +
      (r.status === "stale" ? badge("stale", "neutral") : "") + "</div>" +
      (r.summary ? '<p class="tl__body">' + esc(r.summary) + "</p>" : "") +
      '<div class="meta">' + esc(r.path || "") + (p ? " · from “" + esc(p.title) + "”" : "") + "</div>" +
      ((r.exhibits || []).length ? '<div class="meta">' + r.exhibits.map(u =>
        '<a href="' + esc(u) + '" target="_blank" rel="noopener">exhibit <span class="ext">&#8599;</span></a>').join(" · ") + "</div>" : "") +
      "</article>";
  }).join("") + "</div>";
  wireRelations(view);
}

function archive(rows, word) {
  return '<details class="arch"><summary>' + rows.length + " " + word + " · archived</summary><div class=\"arch__list\">" +
    rows.map(r => '<div class="arch__row"><span>' + esc(r.status || "") + "</span><b>" + esc(r.title || r.id) + "</b>" +
      (r.url ? '<a class="meta" href="' + esc(r.url) + '" target="_blank" rel="noopener">open <span class="ext">&#8599;</span></a>' : "<span></span>") +
      "</div>").join("") + "</div></details>";
}

/* —— chrome —— */
function renderChrome() {
  const name = (state.project && state.project.project) || document.title.replace(/\s*Console\s*$/, "") || "Console";
  el("wordmark").innerHTML = esc(name) + '<span class="stop">.</span>';
  const open = state.proposals.filter(p => p.status === "open").length;
  const answered = state.proposals.filter(p => p.status === "answered").length;
  const stale = state.maps.filter(m => m.status === "stale").length;
  el("n-inbox").textContent = open + answered ? String(open + answered) : "";
  el("n-maps").textContent = state.maps.filter(m => m.status !== "retired").length || "";
  el("n-reports").textContent = state.reports.filter(r => r.status === "current").length || "";
  el("n-history").textContent = state.records.length || "";
  const bits = [];
  const checked = state.maps.map(m => m.checked_at).filter(Boolean).sort().pop();
  if (checked) bits.push("synced " + ago(checked));
  if (stale) bits.push(stale + (stale === 1 ? " stale map" : " stale maps"));
  if (!state.canEdit && state.ready) bits.push("read only");
  el("stamp").textContent = bits.join(" · ") || (state.ready ? "nothing synced yet" : "connecting");
}

function renderAll() { renderChrome(); renderInbox(); renderMaps(); renderReports(); renderHistory(); }

function setView(name) {
  state.view = name;
  ["inbox", "maps", "reports", "history"].forEach(v => {
    el("view-" + v).hidden = v !== name;
    el("tab-" + v).setAttribute("aria-selected", String(v === name));
  });
  const tab = el("tab-" + name), ind = el("tab-ind");
  ind.style.width = tab.offsetWidth + "px";
  ind.style.transform = "translateX(" + tab.offsetLeft + "px)";
  drawDiagrams(el("view-" + name));
}

function toast(title, line, tone) {
  const node = document.createElement("div");
  node.className = "toast" + (tone ? " toast--" + tone : "");
  node.innerHTML = "<b>" + esc(title) + "</b>" + (line ? "<span>" + esc(line) + "</span>" : "");
  el("toasts").appendChild(node);
  setTimeout(() => node.remove(), 5200);
}

/* —— boot —— */
el("tabs").addEventListener("click", e => {
  const tab = e.target.closest(".tab");
  if (tab) setView(tab.dataset.view);
});
window.addEventListener("resize", () => setView(state.view));
if (window.matchMedia) {
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  mq.addEventListener && mq.addEventListener("change", redrawDiagrams);
}
new MutationObserver(redrawDiagrams).observe(document.documentElement, {attributes: true, attributeFilter: ["data-theme"]});
renderAll();
setView("inbox");

(async () => {
  const db = window.claude && await window.claude.use("db");
  const user = window.claude && await window.claude.use("user");
  state.canEdit = !!(user && user.canEdit && user.canEdit());
  if (!db) {
    state.ready = true;
    el("stamp").textContent = "signed out";
    el("view-inbox").innerHTML = '<div class="empty"><p>The console reads its rows as the signed-in viewer, and nobody is signed in here.</p></div>';
    renderChrome();
    return;
  }
  state.db = db;
  state.ready = true;
  db.doc("meta/project").onSnapshot(snap => { state.project = snap.data() || null; renderChrome(); }, () => {});
  COLLECTIONS.forEach(name => {
    db.collection(name).onSnapshot(snap => {
      state[name] = snap.docs.map(d => Object.assign({id: d.id}, d.data() || {}));
      renderAll();
      if (name === "proposals" && state.proposals.some(p => p.status === "open" || p.status === "answered")) setView(state.view);
    }, err => toast("Could not read " + name, (err && err.message) || "", "warning"));
  });
})();
</script>
