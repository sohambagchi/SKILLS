@media (prefers-reduced-motion:reduce){*{animation-duration:1ms !important;transition-duration:1ms !important}}
</style>

<header class="hdr">
  <div class="wrap hdr__in">
    <div class="wordmark" id="wordmark">Console<span class="stop">.</span></div>
    <div class="tabs" role="tablist" id="tabs">
      <button class="tab" role="tab" id="tab-inbox" aria-selected="true" data-view="inbox">Inbox<span class="tab__n" id="n-inbox"></span></button>
      <button class="tab" role="tab" id="tab-maps" aria-selected="false" data-view="maps">Maps<span class="tab__n" id="n-maps"></span></button>
      <button class="tab" role="tab" id="tab-reports" aria-selected="false" data-view="reports">Reports<span class="tab__n" id="n-reports"></span></button>
      <button class="tab" role="tab" id="tab-history" aria-selected="false" data-view="history">History<span class="tab__n" id="n-history"></span></button>
      <span class="tabs__ind" id="tab-ind"></span>
