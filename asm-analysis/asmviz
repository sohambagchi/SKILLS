#!/usr/bin/env python3
"""asmviz: reference tooling for the asm-analysis bundle format.

Four subcommands, no dependencies beyond the standard library:

  check   validate a bundle against the format and its invariants, and validate an
          annotation store against that bundle
  stats   counts, coverage, and the mapping-quality counters
  chunks  propose a partition of the corpus into annotation work chunks
  serve   serve the reference 2xN workspace, reading and writing the annotation store

Nothing here knows anything about a particular project, language or toolchain. Every
project-specific fact is read from the bundle. If this script ever needs to test a
variant by name, the bundle is underspecified -- fix the format, not this file.

See SKILL.md for the format itself; section references below point into it.
"""
import argparse
import gzip
import http.server
import io
import json
import os
import re
import socketserver
import sys
import urllib.parse
from collections import defaultdict

SCHEMA = 1
KEY_VERSION = "1"

# ---------------------------------------------------------------- keys (SKILL.md §3)

_ESCAPE = {"%": "%25", "|": "%7C"}


def _enc(part):
    if part is None:
        return "-"
    s = str(part)
    for raw, sub in _ESCAPE.items():
        s = s.replace(raw, sub)
    return s or "-"


def _dec(part):
    return urllib.parse.unquote(part)


def norm_addr(addr):
    """Canonical lowercase 0x spelling. Normalizing here -- and only here -- is what
    stops 0xA1B and a1b becoming two rows."""
    if addr is None:
        return None
    if isinstance(addr, int):
        return hex(addr)
    s = str(addr).strip().lower()
    if s.startswith("0x"):
        s = s[2:]
    s = s.lstrip("0") or "0"
    return "0x" + s


def parse_addr(addr):
    if isinstance(addr, int):
        return addr
    try:
        return int(str(addr), 16)
    except (TypeError, ValueError):
        return None


def high_key(variant, unit, file, line):
    return "|".join(["hi", KEY_VERSION, _enc(variant), _enc(unit), _enc(file), _enc(line)])


def low_key(kind, variant, artifact, address):
    return "|".join(
        ["lo", KEY_VERSION, _enc(kind), _enc(variant), _enc(artifact), _enc(norm_addr(address))]
    )


def container_key(variant, artifact, start, stop):
    return "|".join(
        ["ct", KEY_VERSION, _enc(variant), _enc(artifact), _enc(norm_addr(start)), _enc(norm_addr(stop))]
    )


KEY_ARITY = {"hi": 6, "lo": 6, "ct": 6}


def parse_key(key):
    """-> (space, dict) or (None, reason). Keys are opaque everywhere else."""
    if not isinstance(key, str) or "|" not in key:
        return None, "not a key string"
    parts = key.split("|")
    space = parts[0]
    if space not in KEY_ARITY:
        return None, "unknown key space %r" % space
    if len(parts) != KEY_ARITY[space]:
        return None, "%s key has %d components, expected %d" % (space, len(parts), KEY_ARITY[space])
    if parts[1] != KEY_VERSION:
        return None, "key space version %r is not %r" % (parts[1], KEY_VERSION)
    vals = [_dec(p) for p in parts[2:]]
    if space == "hi":
        return "hi", dict(zip(("variant", "unit", "file", "line"), vals))
    if space == "lo":
        return "lo", dict(zip(("kind", "variant", "artifact", "address"), vals))
    return "ct", dict(zip(("variant", "artifact", "start", "stop"), vals))


def project_high_key(key, scope):
    """The auto-link projection (§3): two high rows correspond automatically when
    their keys are equal after projecting onto the declared scope."""
    space, fields = parse_key(key)
    if space != "hi":
        return None
    return "|".join(_enc(fields.get(c)) for c in scope)


# ------------------------------------------------------------------- bundle loading

JS_WRAPPER = re.compile(r"^\s*(?:window\.)?[A-Za-z_$][\w$]*\s*=\s*", re.S)


def load_bundle(path):
    """Accepts bundle.json, or the bundle.js wrapper form that lets a workspace open
    over file:// where fetch is blocked."""
    with open(path, "r", encoding="utf-8") as fh:
        text = fh.read()
    stripped = text.lstrip()
    if not stripped.startswith("{"):
        lines = [ln for ln in text.splitlines() if not ln.lstrip().startswith("//")]
        text = "\n".join(lines)
        m = JS_WRAPPER.search(text)
        if not m:
            raise SystemExit("%s: not JSON and not a recognised bundle.js wrapper" % path)
        text = text[m.end():].strip().rstrip(";")
    return json.loads(text)


def load_store(directory):
    """The authored half (§5). Every file is optional; absence is not an error."""
    store = {"tags": [], "groups": [], "chunks": [], "adjudications": {}, "notes": {}}
    if not directory or not os.path.isdir(directory):
        return store

    def read(name):
        p = os.path.join(directory, name)
        if not os.path.exists(p):
            return None
        with open(p, "r", encoding="utf-8") as fh:
            return json.load(fh)

    tags = read("tags.json") or {}
    store["tags"] = tags.get("tags", []) if isinstance(tags, dict) else tags
    groups = read("equivalences.json") or {}
    store["groups"] = groups.get("groups", []) if isinstance(groups, dict) else groups
    chunks = read("chunks.json") or {}
    store["chunks"] = chunks.get("chunks", []) if isinstance(chunks, dict) else chunks
    adj = read("adjudications.json") or {}
    store["adjudications"] = {k: v for k, v in adj.items() if not k.startswith("_")}

    notes_dir = os.path.join(directory, "notes")
    if os.path.isdir(notes_dir):
        for name in sorted(os.listdir(notes_dir)):
            if not name.endswith(".json"):
                continue
            with open(os.path.join(notes_dir, name), "r", encoding="utf-8") as fh:
                store["notes"][name[:-5]] = json.load(fh)
    return store


def dump_json(obj, path):
    """Deterministic serialization, so a diff shows the judgement that changed."""
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(obj, fh, indent=2, sort_keys=True, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)


def canonical_manifest_hash(groups):
    """Membership-only, id-independent (§5). Answers 'did this change any curated
    meaning?' with one comparison, and survives renumbering."""
    import hashlib

    rows = sorted(sorted(g.get("members", [])) for g in groups)
    blob = json.dumps(rows, separators=(",", ":"), sort_keys=True).encode()
    return "sha256:" + hashlib.sha256(blob).hexdigest()


# ------------------------------------------------------------------ indexing helpers


def variants_of(bundle):
    return sorted(bundle.get("variants", []), key=lambda v: (v.get("order", 0), v.get("id", "")))


def containers_by_variant(bundle):
    out = defaultdict(list)
    for c in bundle.get("containers", []):
        out[c.get("variant")].append(c)
    for v in out:
        out[v].sort(key=lambda c: (parse_addr(c.get("start")) or 0, c.get("name") or ""))
    return out


def resolve(bundle, table, value):
    """Internable fields (§4) hold either a literal string or an integer index into
    bundle['strings'][table]. One resolver, used everywhere such a field is read."""
    if isinstance(value, bool) or not isinstance(value, int):
        return value
    arr = (bundle.get("strings") or {}).get(table) or []
    return arr[value] if 0 <= value < len(arr) else None


def frame_file(bundle, frame):
    return resolve(bundle, "file", frame.get("file"))


def row_text(bundle, row):
    return resolve(bundle, "text", row.get("text"))


def auto_link_scope(bundle):
    corp = bundle.get("corpus", {})
    scope = (corp.get("correspondence") or {}).get("autoLink")
    return list(scope) if scope else ["variant", "unit", "file", "line"]


# ------------------------------------------------------------------- check (§4, §5)


class Report:
    def __init__(self):
        self.errors = []
        self.warnings = []

    def error(self, msg):
        self.errors.append(msg)

    def warn(self, msg):
        self.warnings.append(msg)

    def finish(self, label):
        for w in self.warnings:
            print("warn:  %s" % w)
        for e in self.errors:
            print("ERROR: %s" % e)
        if self.errors:
            print("\n%s: %d error(s), %d warning(s)" % (label, len(self.errors), len(self.warnings)))
            return 1
        print("%s: ok (%d warning(s))" % (label, len(self.warnings)))
        return 0


def check_bundle(bundle, store, rep):
    corp = bundle.get("corpus", {})
    if bundle.get("schema") != SCHEMA:
        rep.error("bundle schema is %r, expected %d" % (bundle.get("schema"), SCHEMA))
    if bundle.get("kind") != "asm-analysis/bundle":
        rep.error("bundle kind is %r" % bundle.get("kind"))
    if not corp.get("contract"):
        rep.error("corpus.contract is missing -- state what is in scope and what is not")
    if corp.get("relevance") not in ("overlay", "cited", "declared", None):
        rep.error("corpus.relevance is %r" % corp.get("relevance"))

    variants = variants_of(bundle)
    ids = [v.get("id") for v in variants]
    if len(set(ids)) != len(ids):
        rep.error("duplicate variant ids: %r" % [i for i in ids if ids.count(i) > 1])
    declared = corp.get("variantCount")
    if declared is None:
        rep.error("corpus.variantCount is missing -- a truncated bundle must fail loudly")
    elif declared != len(variants):
        rep.error("corpus.variantCount is %r but the bundle carries %d" % (declared, len(variants)))

    artifact = {}
    for v in variants:
        if not v.get("artifactHash"):
            rep.error("variant %r has no artifactHash" % v.get("id"))
        artifact[v.get("id")] = v.get("artifactHash")
        if not v.get("sourceRev"):
            rep.warn("variant %r has no sourceRev" % v.get("id"))

    # units: every unit appears in every variant, possibly not-applicable (§4)
    for u in bundle.get("units", []):
        real = u.get("realizations", {})
        for vid in ids:
            if vid not in real:
                rep.error("unit %r has no realization for variant %r" % (u.get("id"), vid))
            elif real[vid].get("status") not in (
                "present", "inlined-away", "absent", "not-applicable"
            ):
                rep.error(
                    "unit %r variant %r has status %r" % (u.get("id"), vid, real[vid].get("status"))
                )

    sources = bundle.get("sources", {})
    scope = auto_link_scope(bundle)
    if any(c not in ("variant", "unit", "file", "line") for c in scope):
        rep.error("corpus.correspondence.autoLink has an unknown component: %r" % scope)

    seen_high = set()
    seen_low = set()
    for vid in ids:
        spans = []
        for c in containers_by_variant(bundle).get(vid, []):
            check_container(bundle, c, vid, artifact.get(vid), sources, rep, seen_high, seen_low)
            lo, hi = parse_addr(c.get("start")), parse_addr(c.get("stop"))
            if lo is not None and hi is not None:
                spans.append((lo, hi, c.get("name")))
        spans.sort()
        for (a_lo, a_hi, a_name), (b_lo, b_hi, b_name) in zip(spans, spans[1:]):
            if b_lo < a_hi and not (a_lo == b_lo and a_hi == b_hi):
                rep.error(
                    "variant %r: containers %r and %r overlap without being exact aliases"
                    % (vid, a_name, b_name)
                )

    check_overlay(bundle, rep)
    check_store(bundle, store, rep, seen_high, seen_low, artifact)
    return seen_high, seen_low


def check_container(bundle, c, vid, artifact, sources, rep, seen_high, seen_low):
    name = c.get("name") or c.get("id")
    where = "variant %r container %r" % (vid, name)
    rows = c.get("rows") or []
    if not rows:
        rep.error("%s: no decoded rows" % where)
        return
    start, stop = parse_addr(c.get("start")), parse_addr(c.get("stop"))

    prev = None
    for i, r in enumerate(rows):
        addr = parse_addr(r.get("address"))
        if addr is None:
            rep.error("%s: row %d has unparseable address %r" % (where, i, r.get("address")))
            continue
        if prev is not None and addr <= prev:
            rep.error("%s: addresses are not strictly monotonic at row %d" % (where, i))
        prev = addr
        key = r.get("key")
        if key:
            space, fields = parse_key(key)
            if space != "lo":
                rep.error("%s: row %d key is not a low-row key (%s)" % (where, i, fields))
            else:
                if fields["variant"] != vid:
                    rep.error("%s: row %d key names variant %r" % (where, i, fields["variant"]))
                if artifact and fields["artifact"] != artifact:
                    rep.error("%s: row %d key carries a different artifact hash" % (where, i))
                if fields["address"] != norm_addr(r.get("address")):
                    rep.error("%s: row %d key address disagrees with the row" % (where, i))
                if key in seen_low:
                    rep.error("%s: row %d key is not unique" % (where, i))
                seen_low.add(key)
        if start is not None and r.get("offset") is not None and addr - start != r["offset"]:
            rep.error(
                "%s: row %d offset %r does not match address - container start"
                % (where, i, r.get("offset"))
            )
        frames = r.get("frames") or []
        for f in frames:
            fk = f.get("key")
            if fk:
                space, fields = parse_key(fk)
                if space != "hi":
                    rep.error("%s: row %d frame key is not a high-row key (%s)" % (where, i, fields))
                else:
                    seen_high.add(fk)
            fpath, fline = frame_file(bundle, f), f.get("line")
            if isinstance(f.get("file"), int) and fpath is None:
                rep.error("%s: row %d frame file index %r is out of range"
                          % (where, i, f.get("file")))
            if fpath and fline is not None:
                src = (sources.get(vid) or {}).get(fpath)
                if src is None:
                    rep.error("%s: row %d cites %s, which the bundle carries no source for"
                              % (where, i, fpath))
                elif src.get("available") and src.get("lineCount") is not None:
                    if fline > src["lineCount"]:
                        rep.error(
                            "%s: row %d cites %s:%d but that file has %d lines -- wrong revision"
                            % (where, i, fpath, fline, src["lineCount"])
                        )
        if frames and not any(f.get("physical") for f in frames):
            rep.warn("%s: row %d has no frame marked physical" % (where, i))

    # decode covers exactly [start, stop)
    if start is not None and parse_addr(rows[0].get("address")) != start:
        rep.error("%s: first row is not at the container start" % where)
    if stop is not None:
        last = rows[-1]
        nbytes = len((last.get("bytes") or "").split())
        end = parse_addr(last.get("address"))
        if end is not None and nbytes and end + nbytes != stop:
            rep.error(
                "%s: decode ends at %s but the container stops at %s"
                % (where, hex(end + nbytes), hex(stop))
            )
    if c.get("instructionCount") not in (None, len(rows)):
        rep.error("%s: instructionCount is %r but %d rows are present"
                  % (where, c.get("instructionCount"), len(rows)))

    for unit, occs in (c.get("unitOccurrences") or {}).items():
        for o in occs:
            if not (0 <= o.get("startIndex", -1) <= o.get("stopIndex", -1) < len(rows)):
                rep.error("%s: unit %r has an out-of-range occurrence %r" % (where, unit, o))


def check_overlay(bundle, rep):
    overlay = bundle.get("overlay")
    if not overlay:
        return
    by_variant = containers_by_variant(bundle)
    for vid, report in (overlay.get("reports") or {}).items():
        declared = report.get("artifactHash")
        variant = next((v for v in bundle.get("variants", []) if v.get("id") == vid), None)
        if variant and declared and declared != variant.get("artifactHash"):
            rep.error("overlay for %r measures a different build than the bundle decodes" % vid)
        decoded = {}
        for c in by_variant.get(vid, []):
            for r in c.get("rows") or []:
                decoded[norm_addr(r.get("address"))] = (r.get("bytes") or "").lower()
        measured = {norm_addr(i.get("address")): (i.get("bytes") or "").lower()
                    for i in report.get("instructions") or []}
        # Set equality, not containment: a subset check passes on a partial overlay.
        missing = set(measured) - set(decoded)
        if missing:
            rep.error("overlay for %r measures %d address(es) outside the decoded space"
                      % (vid, len(missing)))
        for addr, mb in measured.items():
            db = decoded.get(addr)
            if db and mb and db != mb:
                rep.error("overlay for %r disagrees with the decode at %s (bytes, not text)"
                          % (vid, addr))


def check_store(bundle, store, rep, seen_high, seen_low, artifact):
    claimed = {}
    for g in store["groups"]:
        members = g.get("members") or []
        if len(members) < 2:
            rep.error("equivalence group %r has %d member(s)" % (g.get("id"), len(members)))
        if not g.get("note"):
            rep.error("equivalence group %r has no note" % g.get("id"))
        for m in members:
            if m not in seen_high:
                rep.error("equivalence group %r cites %s, which no row carries -- rotted"
                          % (g.get("id"), m))
            if m in claimed and claimed[m] != g.get("id"):
                rep.error("high row %s is claimed by both %r and %r"
                          % (m, claimed[m], g.get("id")))
            claimed[m] = g.get("id")

    tag_ids = set()
    texts = []
    for c in bundle.get("containers", []):
        for r in c.get("rows") or []:
            texts.append(row_text(bundle, r) or "")
    for t in store["tags"]:
        tid = t.get("id")
        if tid in tag_ids:
            rep.error("duplicate tag id %r" % tid)
        tag_ids.add(tid)
        if t.get("kind") not in ("instruction", "source", "component", None):
            rep.error("tag %r has kind %r" % (tid, t.get("kind")))
        match = t.get("match") or {}
        if match.get("text"):
            try:
                pat = re.compile(match["text"])
            except re.error as exc:
                rep.error("tag %r has an invalid match regex: %s" % (tid, exc))
                continue
            if not any(pat.search(txt) for txt in texts):
                # An instruction rule that selects nothing has rotted. A component tag
                # legitimately matches zero rows (§6).
                if t.get("kind") == "component":
                    rep.warn("component tag %r matches no row" % tid)
                else:
                    rep.error("tag %r matches no row -- the rule has rotted" % tid)

    for name, nf in store["notes"].items():
        vid = nf.get("variant")
        declared = nf.get("artifactHash")
        if vid and vid not in artifact:
            rep.error("notes/%s names unknown variant %r" % (name, vid))
        elif declared and artifact.get(vid) and declared != artifact[vid]:
            rep.error(
                "notes/%s was written against %s but the bundle carries %s -- re-anchor the "
                "notes rather than editing the hash" % (name, declared[:19], artifact[vid][:19])
            )
        addrs = {}
        for c in bundle.get("containers", []):
            if c.get("variant") != vid:
                continue
            for r in c.get("rows") or []:
                addrs[norm_addr(r.get("address"))] = r
        for addr, note in (nf.get("notes") or {}).items():
            row = addrs.get(norm_addr(addr))
            if row is None:
                rep.error("notes/%s: %s is not an instruction in this bundle" % (name, addr))
                continue
            body = note.get("body") if isinstance(note, dict) else note
            if not (body or "").strip():
                rep.error("notes/%s: %s has an empty body" % (name, addr))
            if isinstance(note, dict):
                if note.get("confidence") not in ("high", "medium"):
                    rep.error("notes/%s: %s has confidence %r -- use an omission instead"
                              % (name, addr, note.get("confidence")))
                for field in ("container", "offset", "bytes"):
                    if note.get(field) in (None, ""):
                        rep.error("notes/%s: %s has no %s -- it cannot be re-anchored"
                                  % (name, addr, field))
                if note.get("bytes") and row.get("bytes") and \
                        note["bytes"].lower() != row["bytes"].lower():
                    rep.error("notes/%s: %s bytes disagree with the decode" % (name, addr))
        overlap = set(nf.get("notes") or {}) & set(nf.get("omissions") or {})
        if overlap:
            rep.error("notes/%s: %d address(es) both noted and omitted" % (name, len(overlap)))


def cmd_check(args):
    bundle = load_bundle(args.bundle)
    store = load_store(args.annotations)
    rep = Report()
    check_bundle(bundle, store, rep)
    if store["groups"]:
        print("equivalence manifest %s" % canonical_manifest_hash(store["groups"]))
    return rep.finish(os.path.basename(args.bundle))


# -------------------------------------------------------------------------- stats


def cmd_stats(args):
    bundle = load_bundle(args.bundle)
    store = load_store(args.annotations)
    by_variant = containers_by_variant(bundle)
    noted = defaultdict(set)
    omitted = defaultdict(set)
    for nf in store["notes"].values():
        noted[nf.get("variant")].update(norm_addr(a) for a in (nf.get("notes") or {}))
        omitted[nf.get("variant")].update(norm_addr(a) for a in (nf.get("omissions") or {}))

    print("corpus: %s" % (bundle.get("corpus", {}).get("title") or bundle.get("corpus", {}).get("id")))
    print("contract: %s" % bundle.get("corpus", {}).get("contract", "-"))
    print("auto-link scope: %s" % "+".join(auto_link_scope(bundle)))
    print()
    head = "%-22s %7s %7s %7s %7s %7s" % ("variant", "cont", "rows", "cited", "noted", "omit")
    print(head)
    print("-" * len(head))
    for v in variants_of(bundle):
        vid = v["id"]
        conts = by_variant.get(vid, [])
        rows = [r for c in conts for r in (c.get("rows") or [])]
        cited = set()
        for r in rows:
            for f in r.get("frames") or []:
                fp = frame_file(bundle, f)
                if fp and f.get("line") is not None:
                    cited.add((fp, f["line"]))
        print("%-22s %7d %7d %7d %7d %7d" % (
            vid, len(conts), len(rows), len(cited),
            len(noted.get(vid, ())), len(omitted.get(vid, ()))))

    counters = defaultdict(int)
    for u in bundle.get("units", []):
        for vid, real in (u.get("realizations") or {}).items():
            for k, n in (real.get("qualityCounters") or {}).items():
                counters[k] += n if isinstance(n, int) else 0
    if counters:
        print("\nmapping quality (summed over units)")
        for k in sorted(counters):
            print("  %-34s %d" % (k, counters[k]))

    if store["groups"]:
        sizes = defaultdict(int)
        for g in store["groups"]:
            sizes[len(g.get("members", []))] += 1
        print("\nequivalence groups: %d (%s)" % (
            len(store["groups"]),
            ", ".join("%d x%d" % (n, sizes[n]) for n in sorted(sizes))))
        print("manifest %s" % canonical_manifest_hash(store["groups"]))
    return 0


# ------------------------------------------------------------------- chunks (§8)


def cmd_chunks(args):
    """Propose a partition. Every row carrying a reviewed attribution lands in exactly
    one chunk; chunks may span non-contiguous ranges."""
    bundle = load_bundle(args.bundle)
    store = load_store(args.annotations)
    by_variant = containers_by_variant(bundle)

    def bucket_of(row, container):
        if args.by == "container":
            return container.get("name") or container.get("id")
        if args.by == "file":
            for f in row.get("frames") or []:
                fp = frame_file(bundle, f)
                if fp:
                    return fp
            return "<no-file>"
        # A principal unit owns the helpers inlined into it, so a row is owned by its
        # outermost (physical) frame's unit. A helper that was NOT inlined is its own
        # physical frame, so it owns its own rows -- one rule covers both cases.
        frames = row.get("frames") or []
        phys = next((f for f in reversed(frames) if f.get("physical")), None) or \
            (frames[-1] if frames else None)
        if phys and phys.get("key"):
            space, fields = parse_key(phys["key"])
            if space == "hi" and fields.get("unit") not in (None, "-"):
                return fields["unit"]
        units = row.get("units") or []
        return units[-1] if units else (container.get("chapter") or "<unattributed>")

    proposed = []
    for v in variants_of(bundle):
        vid = v["id"]
        buckets = defaultdict(list)
        for c in by_variant.get(vid, []):
            for r in c.get("rows") or []:
                buckets[bucket_of(r, c)].append((c, r))
        for name in sorted(buckets):
            rows = buckets[name]
            nsplit = max(1, -(-len(rows) // args.size))
            per = -(-len(rows) // nsplit)
            for i in range(nsplit):
                part = rows[i * per:(i + 1) * per]
                if not part:
                    continue
                suffix = "" if nsplit == 1 else ".s%02d" % (i + 1)
                proposed.append({
                    "id": "%s__%s%s" % (vid, re.sub(r"[^\w.-]+", "-", str(name)), suffix),
                    "title": "%s in %s" % (name, vid),
                    "variant": vid,
                    "axis": args.by,
                    "member": name,
                    "artifactHash": v.get("artifactHash"),
                    "ownedAddresses": [norm_addr(r.get("address")) for _, r in part],
                    "containers": sorted({c.get("name") or c.get("id") for c, _ in part}),
                    "state": "ready",
                    "assignee": None,
                    "phase": None,
                    "dependsOn": [],
                })

    existing = {c.get("id") for c in store["chunks"]}
    if args.write:
        merged = list(store["chunks"]) + [c for c in proposed if c["id"] not in existing]
        dump_json({"schema": SCHEMA, "axis": args.by, "chunks": merged},
                  os.path.join(args.annotations, "chunks.json"))
        print("wrote %d chunk(s) (%d new) to %s/chunks.json"
              % (len(merged), len(merged) - len(store["chunks"]), args.annotations))
        return 0

    total = sum(len(c["ownedAddresses"]) for c in proposed)
    print("%d chunk(s) over %d row(s), by %s%s\n"
          % (len(proposed), total, args.by, "" if not existing else " (* already in the store)"))
    print("%-46s %7s  %s" % ("chunk", "rows", "state"))
    for c in proposed:
        mark = "*" if c["id"] in existing else " "
        print("%s%-45s %7d  %s" % (mark, c["id"], len(c["ownedAddresses"]), c["state"]))
    print("\nre-run with --write to merge these into %s/chunks.json" % args.annotations)
    return 0


# --------------------------------------------------------------------- serve (§7)


def cmd_serve(args):
    bundle_path = os.path.abspath(args.bundle)
    ann_dir = os.path.abspath(args.annotations) if args.annotations else None
    bundle = load_bundle(bundle_path)
    rep = Report()
    check_bundle(bundle, load_store(ann_dir), rep)
    if rep.errors:
        print("refusing to serve an invalid bundle:\n")
        rep.finish(os.path.basename(bundle_path))
        return 1

    def store_state():
        store = load_store(ann_dir)
        notes, line_tags = {}, defaultdict(list)
        artifact = {v["id"]: v.get("artifactHash") for v in bundle.get("variants", [])}
        for nf in store["notes"].values():
            vid = nf.get("variant")
            for addr, note in (nf.get("notes") or {}).items():
                body = note.get("body") if isinstance(note, dict) else note
                notes[low_key("asm", vid, artifact.get(vid), addr)] = body
            for addr, tids in (nf.get("lineTags") or {}).items():
                line_tags[low_key("asm", vid, artifact.get(vid), addr)] = tids
        return {
            "tags": store["tags"],
            "notes": notes,
            "lineTags": dict(line_tags),
            "equivalences": [g.get("members", []) for g in store["groups"]],
            "chunks": store["chunks"],
            "manifest": canonical_manifest_hash(store["groups"]),
            "writable": bool(ann_dir),
        }

    def write_note(key, body):
        """Writes land in the chunk that owns the address, else an 'unassigned' file.
        Never writes on read (§5) -- only this path writes."""
        if not ann_dir:
            return False, "no annotation directory"
        space, fields = parse_key(key)
        if space != "lo":
            return False, "not a low-row key"
        vid, addr = fields["variant"], fields["address"]
        store = load_store(ann_dir)
        chunk = "unassigned"
        for c in store["chunks"]:
            if c.get("variant") == vid and addr in {norm_addr(a) for a in c.get("ownedAddresses", [])}:
                chunk = c.get("id", chunk)
                break
        row = None
        for c in bundle.get("containers", []):
            if c.get("variant") != vid:
                continue
            for r in c.get("rows") or []:
                if norm_addr(r.get("address")) == addr:
                    row, owner = r, c
                    break
        name = "%s.%s" % (chunk, vid)
        path = os.path.join(ann_dir, "notes", name + ".json")
        nf = store["notes"].get(name) or {
            "schema": SCHEMA, "chunk": chunk, "variant": vid,
            "artifactHash": fields["artifact"], "notes": {}, "omissions": {},
        }
        if (body or "").strip():
            record = {"body": body, "confidence": "medium"}
            if row is not None:
                record.update({
                    "container": owner.get("name") or owner.get("id"),
                    "offset": row.get("offset"),
                    "bytes": row.get("bytes"),
                })
            nf.setdefault("notes", {})[addr] = record
        else:
            nf.setdefault("notes", {}).pop(addr, None)
        dump_json(nf, path)
        return True, None

    def write_equivalence(members):
        if not ann_dir:
            return False, "no annotation directory"
        members = sorted(set(members))
        if len(members) < 2:
            return False, "a group needs at least two members"
        store = load_store(ann_dir)
        groups = [g for g in store["groups"]
                  if not (set(g.get("members", [])) & set(members))]
        # Selecting a member of an established group merges that group's complete
        # transitive membership (§5).
        for g in store["groups"]:
            if set(g.get("members", [])) & set(members):
                members = sorted(set(members) | set(g.get("members", [])))
        groups.append({"id": "g%d" % (len(groups) + 1), "note": "", "members": members})
        dump_json({"schema": SCHEMA, "groups": groups},
                  os.path.join(ann_dir, "equivalences.json"))
        return True, None

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *a):
            if args.verbose:
                sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % a))

        def _send(self, body, ctype, status=200):
            if isinstance(body, str):
                body = body.encode("utf-8")
            enc = None
            if len(body) > 1024 and "gzip" in (self.headers.get("Accept-Encoding") or ""):
                buf = io.BytesIO()
                with gzip.GzipFile(fileobj=buf, mode="wb", mtime=0) as gz:
                    gz.write(body)
                body, enc = buf.getvalue(), "gzip"
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            if enc:
                self.send_header("Content-Encoding", enc)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path
            if path in ("/", "/index.html"):
                return self._send(VIEWER_HTML, "text/html; charset=utf-8")
            if path == "/bundle.json":
                return self._send(json.dumps(bundle, sort_keys=True), "application/json")
            if path == "/api/state":
                return self._send(json.dumps(store_state(), sort_keys=True), "application/json")
            self._send("not found", "text/plain", 404)

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            length = int(self.headers.get("Content-Length") or 0)
            try:
                payload = json.loads(self.rfile.read(length) or b"{}")
            except ValueError:
                return self._send(json.dumps({"ok": False, "error": "bad json"}),
                                  "application/json", 400)
            if path == "/api/note":
                ok, err = write_note(payload.get("key"), payload.get("body", ""))
            elif path == "/api/equivalence":
                ok, err = write_equivalence(payload.get("members") or [])
            else:
                ok, err = False, "unknown endpoint"
            body = {"ok": ok, "error": err}
            if ok:
                body["state"] = store_state()
            self._send(json.dumps(body, sort_keys=True), "application/json", 200 if ok else 400)

    class Server(socketserver.ThreadingTCPServer):
        allow_reuse_address = True
        daemon_threads = True

    with Server(("127.0.0.1", args.port), Handler) as httpd:
        print("asmviz serving %s on http://127.0.0.1:%d/" % (os.path.basename(bundle_path), args.port))
        print("annotations: %s" % (ann_dir or "(read-only: no --annotations given)"))
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print()
    return 0


