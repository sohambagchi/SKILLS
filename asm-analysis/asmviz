# --------------------------------------------------------------------------- main


def main(argv=None):
    ap = argparse.ArgumentParser(prog="asmviz", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("check", help="validate a bundle and an annotation store")
    c.add_argument("bundle")
    c.add_argument("--annotations", "-a", default=None)
    c.set_defaults(func=cmd_check)

    s = sub.add_parser("stats", help="counts, coverage, mapping-quality counters")
    s.add_argument("bundle")
    s.add_argument("--annotations", "-a", default=None)
    s.set_defaults(func=cmd_stats)

    k = sub.add_parser("chunks", help="propose a partition into annotation work chunks")
    k.add_argument("bundle")
    k.add_argument("--annotations", "-a", default="annotations")
    k.add_argument("--by", choices=("unit", "container", "file"), default="unit")
    k.add_argument("--size", type=int, default=120, help="target rows per chunk (default 120)")
    k.add_argument("--write", action="store_true", help="merge the proposal into chunks.json")
    k.set_defaults(func=cmd_chunks)

    v = sub.add_parser("serve", help="serve the reference 2xN workspace")
    v.add_argument("bundle")
    v.add_argument("--annotations", "-a", default=None)
    v.add_argument("--port", "-p", type=int, default=8731)
    v.add_argument("--verbose", action="store_true")
    v.set_defaults(func=cmd_serve)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
