import datetime
import difflib
import hashlib
import json
import os
import re
import subprocess
import sys
import time

SCHEMA = 3
POINTER = ".arty"
HERE = os.path.dirname(os.path.realpath(__file__))
PAGE = os.path.join(HERE, "console.html")

KINDS = ("proposals", "maps", "reports")
PROPOSAL_STATUS = ("open", "answered", "accepted", "withdrawn", "superseded")
MAP_STATUS = ("current", "stale", "retired")
REPORT_STATUS = ("current", "settled", "stale")
CLAIM_STATUS = ("verified", "unverified", "partial", "planned")
URGENCY = ("blocking", "soon", "whenever")

# Ceilings are warnings, not errors: over the line, archive -- don't raise them.
MAX_OPEN_PROPOSALS = 6
MAX_LIVE_MAPS = 12
BLOCKING_AGE_DAYS = 7
CHANGELOG_BEHIND = 15         # commits on HEAD's line before the last changelog reads as old

# Snapshot bounds. A part is one database document, which caps at 256 KiB
# serialized; 150k ASCII characters leaves room for the escaping.
SNAP_COMMITS = 300
SNAP_PART_CHARS = 150000
SNAP_DOC_CHARS = 60000
SNAP_BODY_CHARS = 800
SNAP_FILES_PER_COMMIT = 40
SNAP_DOC_HISTORY = 30
SNAP_VERSIONS = 40
VERSIONED = ("docs/TODO.md", "docs/INDEX.md")   # the docs that change in place
BRIEFS = 30                  # changelogs the page can step back through
BRIEF_NEXT = 4               # TODO items a briefing names

# Where the ADRs, changelogs and stale copies live. These are docky's paths; a repository laid
# out differently names its own in .arty (`adr_dir = docs/ADR`), because the
# layout is a fact about the project and this file knows none.
DOCS_DIRS = {"adr": "docs/adr", "changelog": "docs/changelog", "stale": "docs/stale"}
LIST_MARK = re.compile(r"^(?:[-*+]|\d+[.)])\s+")
STAMP = re.compile(r"^(\d{4}-\d{2}-\d{2})-(\d{4})-([a-z0-9][a-z0-9-]*)\.md$")
VERSION = re.compile(r"^\[(\d+)\.(\d+)\.(\d+)\]\s*")
START = re.compile(r"^Start ([^:]+):")
ID = {
    "proposals": re.compile(r"^p-\d{8}-\d{4}-[a-z0-9-]+$"),
    "maps": re.compile(r"^m-[a-z0-9-]+$"),
    "reports": re.compile(r"^r-\d{8}-[a-z0-9-]+$"),
}
URL = re.compile(r"^https://claude\.ai/artifact/[A-Za-z0-9]+$")
FIGURE_SRC = re.compile(r"^(https://\S+|[A-Za-z0-9_][A-Za-z0-9_./-]*)$")
FIGURE_RENDERING = ("auto", "smooth", "pixelated", "crisp-edges")


# ---------------------------------------------------------------- shell + files

def git(*args, check=True):
    """Run git in the current directory. Returns stdout, right-stripped."""
    p = subprocess.run(("git",) + args, capture_output=True, text=True, errors="replace")
    if check and p.returncode != 0:
        die("git %s: %s" % (" ".join(args), p.stderr.strip()))
    return p.stdout.rstrip()


def die(msg):
    sys.stderr.write("arty: %s\n" % msg)
    sys.exit(2)


def repo_root():
    root = git("rev-parse", "--show-toplevel", check=False)
    if not root:
        die("not a git repository")
    return root


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def read_pointer(root):
    """Parse .arty -- `key = value` lines, blank lines and # comments ignored."""
    path = os.path.join(root, POINTER)
    if not os.path.exists(path):
        return {}
    out = {}
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def load_dump(path):
    """Load a read_db --out_dir tree: <dump>/<collection>/<doc_id>.json.

    Returns {collection: {doc_id: body}}. A `version` field in a body is kept
    out of the row and handed back separately so writes can be pinned.
    """
    rows, versions = {}, {}
    if not os.path.isdir(path):
        die("no such dump directory: %s (read_db with out_dir first)" % path)
    for dirpath, _dirnames, filenames in os.walk(path):
        rel = os.path.relpath(dirpath, path)
        collection = "" if rel == "." else rel.replace(os.sep, "/")
        for name in sorted(filenames):
            if not name.endswith(".json"):
                continue
            with open(os.path.join(dirpath, name)) as fh:
                try:
                    body = json.load(fh)
                except json.JSONDecodeError as exc:
                    die("%s/%s: %s" % (collection, name, exc))
            doc = name[:-5]
            if not isinstance(body, dict):
                die("%s/%s: expected an object" % (collection, doc))
            ver = body.pop("version", None) or body.pop("__version", None)
            if isinstance(ver, int):
                versions.setdefault(collection, {})[doc] = ver
            rows.setdefault(collection, {})[doc] = body
    return rows, versions


def first_line(text, prefix):
    for line in text.splitlines():
        if line.startswith(prefix):
            return line[len(prefix):].strip()
    return ""


def field(text, label):
    """A `**Label:**` value, written bare (docky) or as a list item (`- **Label:**`)."""
    prefix = "**%s:**" % label
    for line in text.splitlines():
        line = LIST_MARK.sub("", line, count=1)
        if line.startswith(prefix):
            return line[len(prefix):].strip()
    return ""


def section(text, heading):
    """The first paragraph or first list item under `## <heading>`, or ""."""
    out, inside, fence = [], False, False
    for line in text.splitlines():
        if not inside:
            inside = line.strip().lower() == "## " + heading.lower()
            continue
        if line.startswith("```"):
            if out:
                break
            fence = not fence
            continue
        if fence:
            continue
        if re.match(r"#{1,2}\s", line):
            break
        if not line.strip() or line.startswith("#"):
            if out:
                break
            continue
        if out and LIST_MARK.match(line):
            break  # the first item only
        out.append(LIST_MARK.sub("", line, count=1))
    return re.sub(r"\*\*|__", "", " ".join(out))


def adr_status(raw):
    """Status from the first word of the Status value.

    docky writes `accepted | superseded by <file>`; other templates qualify it
    (`Accepted. Amends <file>`, `Accepted; partly superseded by <file>`) or add
    `Reversed by <file>`. A decision only amended or partly overtaken still
    stands, so only the leading word counts, and a reversal is shown as the
    superseded decision it is.
    """
    m = re.search(r"[a-z]+", raw.lower())
    if not m:
        return "accepted"
    word = m.group(0)
    return "superseded" if word in ("superseded", "reversed") else word


def first_bullet(text):
    """The first list item, past any `- **Date:** ...` header block under the title."""
    header = True
    for line in text.splitlines():
        if header and (not line.strip() or line.startswith("# ") or line.startswith("  ")
                       or re.match(r"[-*+]\s+\*\*[^*]+:\*\*", line)):
            continue
        header = False
        if line.startswith("- "):
            return line[2:]
    return ""


def one_line(text, limit=160):
    text = re.sub(r"\s+", " ", text).strip()
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)  # links to their text
    return text[: limit - 1] + "…" if len(text) > limit else text


def short(h):
    return h[:10]


def docs_dirs(root, check=True):
    """The ADR, changelog and stale directories: docky's, unless .arty names others.

    A directory .arty names must exist. A typo there would otherwise show zero
    ADRs, which looks exactly like a project that has none. `due` passes
    check=False: a hook is no place to stop on it, and sync will.
    """
    pointer = read_pointer(root)
    dirs = {}
    for kind, default in DOCS_DIRS.items():
        rel = pointer.get(kind + "_dir", "").strip().rstrip("/")
        if check and rel and not os.path.isdir(os.path.join(root, rel)):
            die("%s sets %s_dir = %s, and %s is not a directory"
                % (POINTER, kind, rel, os.path.join(root, rel)))
        dirs[kind] = rel or default
    return dirs


def doc_roots(dirs):
    """What the snapshot walks: docs/, plus any named directory outside it."""
    return ["docs"] + sorted(set(d for d in dirs.values() if d != "docs" and not d.startswith("docs/")))



# -------------------------------------------------------------------- snapshot
#
# The snapshot is everything the page shows about the repository: computed
# here from git and docs/, never written by hand, and replaced whole on every
# sync. Its id is a digest of its content, so an unchanged repository writes
# nothing.

def default_branch():
    ref = git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", check=False)
    candidates = ([ref.split("/", 1)[1]] if "/" in ref else []) + ["main", "master"]
    for name in candidates:
        if git("rev-parse", "--verify", "--quiet", "refs/heads/" + name, check=False):
            return name
    for name in candidates:
        if git("rev-parse", "--verify", "--quiet", "refs/remotes/origin/" + name, check=False):
            return "origin/" + name
    return git("rev-parse", "--abbrev-ref", "HEAD", check=False) or "HEAD"


def web_base(remote):
    """A browsable https base for the remote, when it is a forge we can link."""
    m = re.match(r"^(?:git@|ssh://git@)([^:/]+)[:/](.+?)(?:\.git)?/?$", remote or "")
    if not m:
        m = re.match(r"^https?://(?:[^@/]+@)?([^/]+)/(.+?)(?:\.git)?/?$", remote or "")
    if not m or m.group(1) not in ("github.com", "gitlab.com", "codeberg.org"):
        return None
    return "https://%s/%s" % (m.group(1), m.group(2))


def parse_version(subject):
    m = VERSION.match(subject)
    return [int(m.group(1)), int(m.group(2)), int(m.group(3))] if m else None


def snap_refs(default):
    out = []
    fmt = "%(refname)%00%(objectname)%00%(committerdate:iso-strict)%00%(upstream:short)%00%(subject)"
    for line in git("for-each-ref", "--format=" + fmt, "refs/heads", "refs/remotes", "refs/tags").splitlines():
        refname, obj, date, upstream, subject = (line.split("\0") + [""] * 5)[:5]
        if refname.endswith("/HEAD"):
            continue
        if refname.startswith("refs/heads/"):
            kind, name = "local", refname[len("refs/heads/"):]
        elif refname.startswith("refs/remotes/"):
            kind, name = "remote", refname[len("refs/remotes/"):]
        else:
            kind, name = "tag", refname[len("refs/tags/"):]
        ref = {"name": name, "kind": kind, "hash": short(obj), "t": date,
               "subject": subject, "v": parse_version(subject)}
        if upstream:
            ref["upstream"] = upstream
        if kind != "tag":
            counts = git("rev-list", "--left-right", "--count", "%s...%s" % (default, refname), check=False).split()
            if len(counts) == 2:
                ref["behind"], ref["ahead"] = int(counts[0]), int(counts[1])
                ref["merged"] = ref["ahead"] == 0
        out.append(ref)
    return out


def snap_commits(limit, roots=("docs",)):
    """The newest `limit` commits on every branch, remote and tag, in topo order."""
    fmt = "%x1e%H%x00%P%x00%an%x00%cI%x00%s%x00%b%x1f"
    raw = git("log", "--branches", "--remotes", "--tags", "HEAD", "--topo-order",
              "-n", str(limit), "--numstat", "--format=" + fmt, check=False)
    commits = []
    for rec in raw.split("\x1e")[1:]:
        head, _, stat = rec.partition("\x1f")
        h, parents, author, t, subject, body = (head.split("\0") + [""] * 6)[:6]
        files, docs, add, dele = [], [], 0, 0
        for line in stat.strip().splitlines():
            parts = line.split("\t", 2)
            if len(parts) != 3:
                continue
            a = int(parts[0]) if parts[0].isdigit() else None
            d = int(parts[1]) if parts[1].isdigit() else None
            add += a or 0
            dele += d or 0
            files.append([parts[2], a, d])
            if parts[2] == "README.md" or any(parts[2].startswith(r + "/") for r in roots):
                docs.append(parts[2])
        c = {"h": short(h), "p": [short(x) for x in parents.split()], "a": author, "t": t,
             "s": subject, "v": parse_version(subject), "add": add, "del": dele,
             "nf": len(files), "files": files[:SNAP_FILES_PER_COMMIT]}
        body = body.strip()
        if body:
            c["b"] = body[:SNAP_BODY_CHARS]
        if docs:
            c["docs"] = docs
        commits.append(c)
    return commits


def snap_features(commits, refs, default):
    """Group commits by X.Y -- one Y per branch, by version-commit's rule.

    A feature is merged when its newest commit is reachable from the default
    branch, which holds for fast-forward merges too, where no merge commit
    exists to say so.
    """
    on_default = set(short(h) for h in git("rev-list", "-n", "20000", default, check=False).split())
    tips = {}
    for r in refs:
        if r["kind"] != "tag":
            tips.setdefault(r["hash"], []).append(r)
    groups = {}
    for c in commits:  # newest first
        if not c["v"]:
            continue
        key = "%d.%d" % (c["v"][0], c["v"][1])
        groups.setdefault(key, []).append(c)
    out = []
    for key, cs in groups.items():
        newest, oldest = cs[0], cs[-1]
        name = ""
        for c in cs:
            m = START.match(VERSION.sub("", c["s"]))
            if m and c["v"][2] == 0:
                name = m.group(1).strip()
        branches = []
        for c in cs:
            for r in tips.get(c["h"], []):
                if r["name"] != default and r["name"] not in branches:
                    branches.append(r["name"])
        locals_ = [b for b in branches if "/" not in b] or branches
        if not name and locals_:
            name = locals_[0]
        merged = newest["h"] in on_default
        docs = []
        for c in reversed(cs):
            for d in c.get("docs", []):
                if d not in docs:
                    docs.append(d)
        out.append({
            "key": key, "name": name, "commits": [c["h"] for c in cs],
            "first": oldest["h"], "last": newest["h"], "t0": oldest["t"], "t1": newest["t"],
            "v0": oldest["v"], "v1": newest["v"], "branches": locals_,
            "status": "merged" if merged else ("open" if branches else "unmerged"),
            "docs": docs,
        })
    out.sort(key=lambda f: f["t1"], reverse=True)
    return out


def doc_kind(path, dirs=DOCS_DIRS):
    if path == "README.md":
        return "readme"
    for kind in ("stale", "adr", "changelog"):
        if path.startswith(dirs[kind] + "/"):
            return kind
    rel = path[len("docs/"):]
    if rel == "INDEX.md":
        return "index"
    if rel == "TODO.md":
        return "todo"
    top = rel.split("/", 1)[0] if "/" in rel else ""
    return {"adr": "adr", "changelog": "changelog", "todo": "task", "analysis-artifacts": "analysis",
            "stale": "stale"}.get(top, "other")


def snap_docs(root, dirs=DOCS_DIRS):
    roots = doc_roots(dirs)
    paths = []
    if os.path.isfile(os.path.join(root, "README.md")):
        paths.append("README.md")
    for top in roots:
        for dirpath, dirnames, filenames in os.walk(os.path.join(root, top)):
            dirnames.sort()
            for name in sorted(filenames):
                if name.endswith(".md"):
                    paths.append(os.path.relpath(os.path.join(dirpath, name), root).replace(os.sep, "/"))

    # One walk of HEAD's history for every doc, newest first.
    history = {}
    raw = git("log", "--format=%x1e%H %cI", "--name-only", "--", "README.md", *roots, check=False)
    for rec in raw.split("\x1e")[1:]:
        lines = [l for l in rec.strip().splitlines() if l.strip()]
        if not lines:
            continue
        h, _, t = lines[0].partition(" ")
        for p in lines[1:]:
            history.setdefault(p, []).append([short(h), t])

    dirty = set()
    for line in git("status", "--porcelain=v1", "--untracked-files=all", "--", "README.md", *roots, check=False).splitlines():
        dirty.add(line[3:].split(" -> ")[-1].strip('"'))

    out = []
    for path in paths:
        with open(os.path.join(root, path), errors="replace") as fh:
            text = fh.read()
        kind = doc_kind(path, dirs)
        if kind in ("adr", "changelog") and not STAMP.match(os.path.basename(path)):
            kind = "other"  # a README beside the records is a doc, not a record
        if kind == "stale" and "**Status:**" in text[:4096]:
            orig = "adr"
        elif kind == "stale":
            orig = "changelog" if STAMP.match(os.path.basename(path)) else "other"
        else:
            orig = kind
        title = re.sub(r"\*\*|__|`", "", first_line(text, "# ")) or os.path.basename(path)
        doc = {"path": path, "kind": kind, "title": one_line(title, 120)}
        m = STAMP.match(os.path.basename(path))
        if m:
            doc["date"], doc["time"] = m.group(1), "%s:%s" % (m.group(2)[:2], m.group(2)[2:])
        if orig == "adr":
            doc["status"] = adr_status(field(text, "Status"))
            doc["summary"] = one_line(field(text, "Decision") or section(text, "Decision")
                                      or field(text, "Context") or section(text, "Context")
                                      or first_bullet(text), 240)
        if kind == "stale":
            doc["was"] = orig
        if len(text) > SNAP_DOC_CHARS:
            text = text[:SNAP_DOC_CHARS] + "\n\n*[truncated by arty: %d characters more in the file]*\n" % (len(text) - SNAP_DOC_CHARS)
        doc["md"] = text
        hist = history.get(path, [])
        if hist:
            doc["history"] = [h for h, _t in hist[:SNAP_DOC_HISTORY]]
            doc["added"], doc["added_t"] = hist[-1]
        if path in dirty:
            doc["dirty"] = True
        out.append(doc)
    return out


def snap_versions():
    """Every committed version of the docs that change in place."""
    out = {}
    for path in VERSIONED:
        raw = git("log", "-n", str(SNAP_VERSIONS), "--format=%H %cI", "--", path, check=False)
        vs = []
        for line in raw.splitlines():
            h, _, t = line.partition(" ")
            p = subprocess.run(("git", "show", "%s:%s" % (h, path)), capture_output=True, text=True, errors="replace")
            vs.append({"h": short(h), "t": t, "md": p.stdout[:SNAP_DOC_CHARS] if p.returncode == 0 else None})
        if vs:
            out[path] = vs
    return out


# ------------------------------------------------------------------- briefing
#
# The briefing is read, not written: docky already records each piece of work
# as a changelog and keeps TODO.md current, so the newest changelog says what
# just changed and the TODO list as of that commit says what comes next. Each
# older changelog is an older briefing, with the TODO list as it stood then.

TODO_ITEM = re.compile(r"^\s?[-*]\s+\[([ xX])\]\s+(.*\S)")       # a task; indented ones are its subtasks
SUBTASK = re.compile(r"^\s{2,}[-*]\s+\[([ xX])\]\s+(.*\S)")
MARKER = re.compile(r"\s+(?:—|–|--?)\s*(blocked(?:\s+on)?|details|stages)\s*:\s*((?:(?!\s+(?:—|–|--?)\s*(?:blocked|details|stages)\b).)+)$", re.I)
BLOCKED = re.compile(r"\s+(?:—|–|--?)\s*blocked(?:\s+on)?\s*:\s*(.+)$", re.I)
TAGS = re.compile(r"(?:\s+[#+][a-z][a-z0-9-]*)+$", re.I)
MD_LINK = re.compile(r"\]\(([^)\s]+)\)")

# docky's board: a TODO.md whose `##` headings are all column names. Left to
# right on the page; docky writes them top-down Doing, Review, Next, Backlog.
# A card is one line:
#   - [ ] [Category: ]<task> [#tag ...] [+epic] [— stages: a, [b], c] [— details: <link>] [— blocked: <on what>]
#     - [ ] <subtask>
BOARD = ("Backlog", "Next", "Doing", "Review")
CATEGORIES = ("Feature", "Fix", "Investigate", "Evaluate", "Benchmark", "Refactor", "Deprecate")
CATEGORY = re.compile(r"^(%s)\s*:\s+" % "|".join(CATEGORIES), re.I)
LONG_STAGES = ("rebuild", "measure")   # .arty `long_stages = ...` names a project's own
BOARD_WIP = 3                # cards in Doing before it reads as overloaded
BOARD_STUCK_DAYS = 14        # days a Doing card can sit in one stage (or, staged or not, the column)
BOARD_CLOSED_DAYS = 14       # how far back the Closed column reaches
BOARD_CLOSED_MAX = 12
BOARD_MATCH = 0.8            # similarity at which an edited card is the same card


def git_show(rev, path):
    p = subprocess.run(("git", "show", "%s:%s" % (rev, path)), capture_output=True, text=True, errors="replace")
    return p.stdout if p.returncode == 0 else None


def todo_items(text):
    """docky's TODO.md: open items in order with their section and subtasks, and
    how many top-level items are ticked (a ticked subtask is progress, not litter)."""
    items, ticked, section, last = [], 0, "", None
    for line in (text or "").splitlines():
        h = re.match(r"^#{2,4}\s+(.*)", line)
        if h:
            section, last = h.group(1).strip(), None
            continue
        sub = SUBTASK.match(line)
        if sub:
            if last is not None:
                last.setdefault("subtasks", []).append({"text": sub.group(2), "done": sub.group(1) != " "})
            continue
        m = TODO_ITEM.match(line)
        if not m:
            continue
        if m.group(1) != " ":
            ticked += 1
            last = None
            continue
        item = {"text": m.group(2), "section": section, "raw": m.group(2)}
        b = BLOCKED.search(item["text"])
        if b:
            item["text"], item["blocked"] = item["text"][:b.start()], b.group(1).strip()
        items.append(item)
        last = item
    return items, ticked


def todo_columns(text):
    """The board's columns in file order when TODO.md is one, else None."""
    heads = [h.strip().lower() for h in re.findall(r"^##\s+(.*?)\s*#*\s*$", text or "", re.M)]
    names = {c.lower(): c for c in BOARD}
    return [names[h] for h in heads] if heads and all(h in names for h in heads) else None


def parse_stages(raw):
    """`dev, [rebuild], test` -> stages with their state; the bracketed one is under way."""
    names = [x.strip() for x in raw.split(",") if x.strip()]
    cur = next((i for i, n in enumerate(names) if n.startswith("[") and n.endswith("]")), None)
    return [{"name": n.strip("[]").strip().lower(),
             "state": "todo" if cur is None or i > cur else "now" if i == cur else "done"}
            for i, n in enumerate(names)]


def board_cards(text):
    """A board's cards in order, each parsed into the fields docky's card line carries."""
    if todo_columns(text) is None:
        return None
    names = {c.lower(): c for c in BOARD}
    cards = []
    for it in todo_items(text)[0]:
        column = names.get(it["section"].lower())
        if not column:
            continue
        rest, card = it["raw"], {"column": column}
        while True:                      # the markers, in whatever order they were written
            m = MARKER.search(rest)
            if not m:
                break
            key = m.group(1).lower().split()[0]
            if key == "stages":
                card["stages"] = parse_stages(m.group(2))
            else:
                card[key] = m.group(2).strip()
            rest = rest[:m.start()]
        t = TAGS.search(rest)
        words = t.group(0).split() if t else []
        card["tags"] = [w[1:].lower() for w in words if w[0] == "#"]
        epics = [w[1:].lower() for w in words if w[0] == "+"]
        if epics:
            card["epic"] = epics[0]
        rest = rest[:t.start()] if t else rest
        c = CATEGORY.match(rest)
        if c:
            card["category"] = next(x for x in CATEGORIES if x.lower() == c.group(1).lower())
            rest = rest[c.end():]
        card["text"] = rest
        if it.get("subtasks"):
            card["subtasks"] = it["subtasks"]
        cards.append(card)
    # A blocker that names another card points at it.
    for c in cards:
        if c.get("blocked"):
            key = " ".join(c["blocked"].lower().split())
            hit = [i for i, o in enumerate(cards) if o is not c and len(key) >= 8 and same_card(key, card_key(o)[:len(key)]) >= BOARD_MATCH]
            if hit:
                c["blocked_card"] = hit[0]
    return cards


def card_key(card):
    return " ".join(card["text"].lower().split())


def current_stage(card):
    return next((s["name"] for s in card.get("stages", []) if s["state"] == "now"), None)


def same_card(a, b):
    """How alike two card texts are; a card whose text only grew is the same card."""
    short_, long_ = sorted((a, b), key=len)
    if len(short_) >= 12 and long_.startswith(short_):
        return 1.0
    return difflib.SequenceMatcher(None, a, b).ratio()


def match_cards(now, then):
    """Pair each card in `now` with its card in `then`: same text first, then the
    closest edit. Returns {index in now: index in then}."""
    pairs, free = {}, {}
    for j, c in enumerate(then):
        free.setdefault(card_key(c), []).append(j)
    for i, c in enumerate(now):
        js = free.get(card_key(c))
        if js:
            pairs[i] = js.pop(0)
    left = [j for js in free.values() for j in js]
    for i, c in enumerate(now):
        if i in pairs or not left:
            continue
        score, j = max((same_card(card_key(c), card_key(then[j])), j) for j in left)
        if score >= BOARD_MATCH:
            pairs[i] = j
            left.remove(j)
    return pairs


def epoch(iso):
    return datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()


def walk_back(boards, cards, same, field):
    """Set card[field] (and field_h) to the oldest version, walking back from the
    newest, for which `same(card, older card)` held without a break."""
    trail = {}
    for i, c in enumerate(cards):
        c[field], c[field + "_h"] = boards[0][0]["t"], boards[0][0]["h"]
        trail[i] = i
    for (v, older), (_newer, newer) in zip(boards[1:], boards):
        pairs = match_cards(newer, older)
        for i, j in list(trail.items()):
            k = pairs.get(j)
            if k is None or not same(cards[i], older[k]):
                del trail[i]
            else:
                trail[i] = k
                cards[i][field], cards[i][field + "_h"] = v["t"], v["h"]
        if not trail:
            break
    return trail


def snap_board(docs, versions):
    """docky's board, when TODO.md is one: each card with the commit it entered
    its column (and its current stage) at, and the cards that left the board
    lately. Ages come from committed versions only, so an unchanged repository
    yields the same board; the page counts the days itself."""
    todo = next((d for d in docs if d["path"] == "docs/TODO.md"), None)
    if not todo or todo_columns(todo["md"]) is None:
        return None
    committed = [v for v in versions.get("docs/TODO.md", []) if v.get("md") is not None]
    vs = committed if committed and committed[0]["md"] == todo["md"] else [{"h": None, "t": None, "md": todo["md"]}] + committed
    boards = []
    for v in vs:
        cards = board_cards(v["md"])
        if cards is None:
            break                 # older than the board: a flat list has no columns
        boards.append((v, cards))
    cards = boards[0][1]
    trail = walk_back(boards, cards, lambda c, o: c["column"] == o["column"], "since")
    if len(boards) == len(vs) and len(committed) >= SNAP_VERSIONS:
        for i in trail:
            cards[i]["since_floor"] = True   # there at least since the oldest version kept
    staged = [c for c in cards if current_stage(c)]
    if staged:
        walk_back(boards, cards, lambda c, o: c["column"] == o["column"] and current_stage(c) == current_stage(o), "stage_since")
    for c in cards:
        if not current_stage(c):
            c.pop("stage_since", None)
            c.pop("stage_since_h", None)
    # Closed: cards a version had that the next version no longer has.
    head_t = git("log", "-1", "--format=%ct", check=False)
    horizon = int(head_t) - BOARD_CLOSED_DAYS * 86400 if head_t.isdigit() else 0
    logs = {d["added"]: d["path"] for d in docs if d["kind"] == "changelog" and d.get("added")}
    dirty_log = next((d["path"] for d in docs if d["kind"] == "changelog" and d.get("dirty") and not d.get("added")), None)
    closed = []
    for (v, newer), (_older, older) in zip(boards, boards[1:]):
        if v["t"] and epoch(v["t"]) < horizon:
            break
        kept = set(match_cards(newer, older).values())
        closed += [{k: c[k] for k in ("text", "tags", "epic", "category") if k in c} |
                   {"from": c["column"], "at": v["h"], "t": v["t"], "changelog": logs.get(v["h"]) if v["h"] else dirty_log}
                   for j, c in enumerate(older) if j not in kept]
    pointer = read_pointer(git("rev-parse", "--show-toplevel", check=False) or ".")
    long_ = [x.strip().lower() for x in pointer.get("long_stages", "").split(",") if x.strip()] or list(LONG_STAGES)
    return {"columns": list(BOARD), "cards": cards, "closed": closed[:BOARD_CLOSED_MAX], "wip": BOARD_WIP,
            "stuck_days": BOARD_STUCK_DAYS, "long_stages": long_, "categories": list(CATEGORIES)}


def board_deviations(board):
    if not board:
        return []
    out = []
    doing = [c for c in board["cards"] if c["column"] == "Doing"]
    if len(doing) > BOARD_WIP:
        out.append({"kind": "board", "msg": "%d cards in Doing, over the limit of %d" % (len(doing), BOARD_WIP),
                    "fix": "move the ones not being worked on back to Next (docky)"})
    head_t = git("log", "-1", "--format=%ct", check=False)
    for c in doing:
        stage = current_stage(c)
        since = c.get("stage_since") if stage else c.get("since")
        if not since or not head_t.isdigit():
            continue
        days = (int(head_t) - epoch(since)) / 86400
        if days > BOARD_STUCK_DAYS:
            where = "at its %s stage" % stage if stage else "in Doing"
            out.append({"kind": "board", "msg": "%r has been %s for %d days" % (one_line(c["text"], 60), where, days),
                        "fix": "split it, mark what blocks it, or move it back to Next (docky)"})
    return out


def body_after_title(md):
    lines = md.splitlines()
    while lines and (not lines[0].strip() or lines[0].startswith("# ")):
        lines.pop(0)
    return "\n".join(lines).strip()[:4000]


def snap_briefs(docs, commits, features):
    """One briefing per changelog, newest first; per version-commit feature when
    the repository has no changelogs. The newest reads the working tree's TODO
    list, older ones the TODO list committed with them."""
    by_commit = {c["h"]: c for c in commits}
    todo_now = next((d["md"] for d in docs if d["path"] == "docs/TODO.md"), None)
    order = {c["h"]: -i for i, c in enumerate(commits)}   # ties on the stamp go to the later commit
    logs = sorted((d for d in docs if d["kind"] == "changelog"),
                  key=lambda d: (d.get("date", ""), d.get("time", ""), order.get(d.get("added"), 1)), reverse=True)[:BRIEFS]
    out = []
    if logs:
        adrs = [d for d in docs if d["kind"] == "adr"]
        for d in logs:
            at = d.get("added")
            stamp = (d.get("date"), d.get("time"))
            decided = [{"path": a["path"], "title": a["title"], "summary": a.get("summary", ""), "status": a.get("status")}
                       for a in adrs if (at and a.get("added") == at) or (a.get("date"), a.get("time")) == stamp]
            out.append({"source": "changelog", "doc": d["path"], "title": d["title"], "date": d.get("date"),
                        "time": d.get("time"), "at": at, "changed": body_after_title(d["md"]), "decided": decided,
                        "dirty": bool(d.get("dirty"))})
    else:
        line = set(short(h) for h in git("rev-list", "-n", str(SNAP_COMMITS), "HEAD", check=False).split())
        for f in [f for f in features if f["last"] in line][:BRIEFS]:
            subjects = [by_commit[h]["s"] for h in f["commits"] if h in by_commit][:10]
            out.append({"source": "feature", "feature": f["key"], "title": f["name"] or "version " + f["key"],
                        "date": f["t1"][:10], "at": f["last"],
                        "changed": "\n".join("- " + VERSION.sub("", s) for s in subjects), "decided": []})
    todos = [todo_now if i == 0 else (git_show(b["at"], "docs/TODO.md") if b["at"] else None) for i, b in enumerate(out)]
    for i, b in enumerate(out):
        c = by_commit.get(b["at"]) if b["at"] else None
        b["v"] = c["v"] if c else None
        if todos[i] is None:
            continue
        items = [{k: v for k, v in it.items() if k != "raw"} for it in todo_items(todos[i])[0]]
        open_ = [it for it in items if "blocked" not in it]
        if todo_columns(todos[i]):    # a board: what comes next is Doing, then Next
            rank = {"doing": 0, "next": 1}
            open_ = sorted((it for it in open_ if it["section"].lower() in rank), key=lambda it: rank[it["section"].lower()])
        b["next"], b["next_total"] = open_[:BRIEF_NEXT], len(open_)
        b["blocked"] = [it for it in items if "blocked" in it]
        if i + 1 < len(out) and todos[i + 1] is not None:
            now_texts = set(it["text"] for it in items)
            before = todo_items(todos[i + 1])[0]
            b["closed"] = [it["text"] for it in before if it["text"] not in now_texts][:6]
            b["opened"] = len(now_texts - set(it["text"] for it in before))
    return out


def doc_deviations(root, docs, board=None):
    """What only a session's judgement can fix in docs/, found without one."""
    out = board_deviations(board)
    logs = sorted((d for d in docs if d["kind"] == "changelog" and d.get("added")),
                  key=lambda d: (d.get("date", ""), d.get("time", "")), reverse=True)
    if logs and not any(d["kind"] == "changelog" and not d.get("added") for d in docs):
        n = git("rev-list", "--count", "--first-parent", "%s..HEAD" % logs[0]["added"], check=False)
        if n.isdigit() and int(n) >= CHANGELOG_BEHIND:
            out.append({"kind": "changelog", "msg": "%s commits since the last changelog (%s)" % (n, logs[0]["title"]),
                        "fix": "write a changelog with docky -- the newest changelog is the console's briefing"})
    byp = {d["path"]: d for d in docs}
    todo = byp.get("docs/TODO.md")
    if todo:
        ticked = todo_items(todo["md"])[1]
        if ticked:
            out.append({"kind": "todo", "msg": "%d ticked item%s still in docs/TODO.md" % (ticked, "" if ticked == 1 else "s"),
                        "fix": "remove finished tasks (docky); the changelog records completion"})
    for path in ("docs/TODO.md", "docs/INDEX.md"):
        d = byp.get(path)
        if not d:
            continue
        for target in MD_LINK.findall(d["md"]):
            if re.match(r"^[a-z][a-z0-9+.-]*:|^#", target, re.I):
                continue
            rel = os.path.normpath(os.path.join(os.path.dirname(path), target.split("#", 1)[0]))
            if not os.path.exists(os.path.join(root, rel)):
                out.append({"kind": "link", "msg": "%s links to %s, which does not exist" % (path, rel),
                            "fix": "point it at the moved file or drop the line (docky)"})
    return out


def build_snapshot(root):
    pointer = read_pointer(root)
    default = default_branch()
    remote = git("remote", "get-url", "origin", check=False)
    branch = git("rev-parse", "--abbrev-ref", "HEAD", check=False)
    head = git("log", "-1", "--format=%H%x00%cI%x00%s", check=False).split("\0")
    status = git("status", "--porcelain=v1", check=False).splitlines()
    upstream = git("rev-list", "--left-right", "--count", "@{u}...HEAD", check=False).split()
    refs = snap_refs(default)
    dirs = docs_dirs(root)
    commits = snap_commits(SNAP_COMMITS, doc_roots(dirs))
    features = snap_features(commits, refs, default)
    docs = snap_docs(root, dirs)
    versions = snap_versions()
    board = snap_board(docs, versions)
    snap = {
        "v": 1,
        "project": pointer.get("project") or os.path.basename(root),
        "repo": {
            "default": default, "branch": branch, "web": web_base(remote),
            "head": {"h": short(head[0]), "t": head[1], "s": head[2], "v": parse_version(head[2])} if len(head) == 3 else None,
            "dirty": len(status), "dirty_files": [l[3:] for l in status[:20]],
            "upstream": {"behind": int(upstream[0]), "ahead": int(upstream[1])} if len(upstream) == 2 else None,
            "total_commits": int(git("rev-list", "--count", "HEAD", check=False) or 0),
        },
        "refs": refs,
        "commits": commits,
        "features": features,
        "docs": docs,
        "versions": versions,
        "board": board,
        "briefs": snap_briefs(docs, commits, features),
        "deviations": doc_deviations(root, docs, board),
    }
    body = json.dumps(snap, sort_keys=True, separators=(",", ":"))
    snap["id"] = hashlib.sha1(body.encode()).hexdigest()[:16]
    snap["generated_at"] = now()
    return snap


def snapshot_rows(snap):
    """Split a snapshot into database rows: parts first, the head row last.

    Every row is named by the snapshot's id and written once, never updated:
    creating needs no version pin, and the previous snapshot's rows, all still
    at version 1, are deleted with a pin known in advance.
    """
    body = json.dumps(snap, sort_keys=True, separators=(",", ":"))  # ensure_ascii: one char, one byte
    parts = [body[i:i + SNAP_PART_CHARS] for i in range(0, len(body), SNAP_PART_CHARS)]
    rows = [("p-%s-%03d" % (snap["id"], n), {"id": snap["id"], "n": n, "data": p}) for n, p in enumerate(parts)]
    head = snap["repo"]["head"] or {}
    rows.append(("h-" + snap["id"], {"id": snap["id"], "parts": len(parts), "bytes": len(body),
                                     "generated_at": snap["generated_at"], "head": head.get("h"),
                                     "branch": snap["repo"]["branch"], "schema": SCHEMA}))
    return rows


def latest_head(rows):
    heads = [r for d, r in rows.get("snapshot", {}).items() if d.startswith("h-")]
    return max(heads, key=lambda r: r.get("generated_at") or "") if heads else None


def docs_digest(root):
    """What `due` compares: HEAD plus the working tree's docs, committed or not."""
    h = hashlib.sha1()
    h.update(git("rev-parse", "HEAD", check=False).encode())
    for path in ["README.md"] + sorted(
            os.path.relpath(os.path.join(d, f), root)
            for top in doc_roots(docs_dirs(root, check=False))
            for d, _ds, fs in os.walk(os.path.join(root, top)) for f in fs if f.endswith(".md")):
        full = os.path.join(root, path)
        if os.path.isfile(full):
            h.update(path.encode())
            with open(full, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()[:16]


def synced_path():
    gitdir = git("rev-parse", "--git-common-dir", check=False) or ".git"
    return os.path.join(gitdir, "arty-synced")


# ------------------------------------------------------------------- staleness

def map_staleness(row, limit=5):
    """Commit range: what has touched this map's anchors since it was refreshed.

    Returns (patch, note). The commit range is the signal the user chose over a
    content digest precisely because it can name the commits, so the page can
    show which ones may have invalidated the map.
    """
    anchors = [a for a in row.get("anchors", []) if isinstance(a, str) and a]
    commit = row.get("commit")
    if row.get("status") == "retired":
        return {}, "retired"
    if not anchors:
        return {}, "no anchors - cannot check"
    if not commit:
        return {}, "no commit - register a refresh first"
    if git("cat-file", "-t", commit, check=False) != "commit":
        return {}, "commit %s is not in this repository" % commit[:9]
    tracked = git("ls-files", "--", *anchors)
    if not tracked:
        return {}, "anchors match no tracked file"
    log = git("log", "--format=%h\t%s", "%s..HEAD" % commit, "--", *anchors)
    lines = [l for l in log.splitlines() if l.strip()]
    patch = {"checked_at": now(), "checked_at_commit": git("rev-parse", "--short", "HEAD")}
    if lines:
        patch["status"] = "stale"
        patch["invalidated_count"] = len(lines)
        patch["invalidated_by"] = [
            {"commit": l.split("\t")[0], "subject": one_line(l.split("\t", 1)[1], 90)}
            for l in lines[:limit]
        ]
        return patch, "stale: %d commit%s since %s" % (
            len(lines), "" if len(lines) == 1 else "s", commit[:9])
    patch["status"] = "current"
    patch["invalidated_count"] = 0
    patch["invalidated_by"] = []
    return patch, "current"


def changed(old, new):
    """Fields of `new` that `old` does not already carry, compared as JSON."""
    out = {}
    for k, v in new.items():
        if json.dumps(old.get(k), sort_keys=True) != json.dumps(v, sort_keys=True):
            out[k] = v
    return out


# ----------------------------------------------------------------- subcommands

def cmd_init(args):
    root = repo_root()
    os.chdir(root)
    if not URL.match(args.url):
        die("not an artifact url: %s" % args.url)
    name = args.name or os.path.basename(root)
    pointer = os.path.join(root, POINTER)
    keep = read_pointer(root)  # a re-init must not drop the project's own settings
    with open(pointer, "w") as fh:
        fh.write("# The project console. Live state lives there, not here.\n")
        fh.write("console = %s\n" % args.url)
        fh.write("project = %s\n" % name)
        fh.write("schema = %d\n" % SCHEMA)
        for key in [k + "_dir" for k in DOCS_DIRS] + ["long_stages"]:
            if keep.get(key):
                fh.write("%s = %s\n" % (key, keep[key]))
    remote = git("remote", "get-url", "origin", check=False)
    seed = {
        "project": name,
        "schema": SCHEMA,
        "remote": remote or None,
        "created": now(),
        "head": git("rev-parse", "--short", "HEAD", check=False),
    }
    out = args.seed or os.path.join(root, POINTER + ".seed.json")
    if os.path.dirname(out):
        os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as fh:
        json.dump(seed, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print("wrote %s" % os.path.relpath(pointer, root))
    print("seed %s -> write_db set meta/project" % out)


def cmd_page(args):
    """The page is generic. --project only names it; every other fact is a row."""
    with open(PAGE) as fh:
        page = fh.read()
    title = "%s Console" % args.project if args.project else "Project Console"
    sys.stdout.write(page.replace("<title>Project Console</title>", "<title>%s</title>" % title, 1))


def cmd_snapshot(args):
    root = repo_root()
    os.chdir(root)
    snap = build_snapshot(root)
    with open(args.out, "w") as fh:
        json.dump(snap, fh, sort_keys=True, separators=(",", ":"))
    print("snapshot %s: %d commits, %d features, %d docs, %d bytes" % (
        snap["id"], len(snap["commits"]), len(snap["features"]), len(snap["docs"]), os.path.getsize(args.out)))


def cmd_sync(args):
    root = repo_root()
    os.chdir(root)
    rows, versions = load_dump(args.db)
    plan, notes, quiet = [], [], 0

    def entry(op, collection, doc, body, note):
        item = {"op": op, "collection": collection, "doc_id": doc}
        if body is not None:
            path = os.path.join(args.plan, collection)
            os.makedirs(path, exist_ok=True)
            path = os.path.abspath(os.path.join(path, doc + ".json"))
            with open(path, "w") as fh:
                json.dump(body, fh, sort_keys=True)
                fh.write("\n")
            item["file_path"] = path
        ver = versions.get(collection, {}).get(doc)
        if op in ("update", "delete"):
            item["if_version"] = ver or "<version from the read>"
        plan.append(item)
        notes.append("  %-6s %s/%s  (%s)" % (op, collection, doc, note))

    meta = rows.get("meta", {}).get("project")
    if meta and meta.get("schema") != SCHEMA:
        entry("update", "meta", "project", {"schema": SCHEMA}, "schema %s -> %d" % (meta.get("schema"), SCHEMA))

    # Schema 1 projected ADRs and changelogs into `records`; the snapshot now
    # carries the whole docs tree, so those rows are derived copies to drop.
    for rid in sorted(rows.get("records", {})):
        entry("delete", "records", rid, None, "schema 2 drops records")
    # Schema 2 had agent-written briefings; schema 3 reads them from docky's changelogs.
    for bid in sorted(rows.get("briefings", {})):
        entry("delete", "briefings", bid, None, "schema 3 reads the briefing from the changelogs")

    snap = build_snapshot(root)
    have = rows.get("snapshot", {})
    if "h-" + snap["id"] in have and not args.force:
        quiet += 1
        notes.append("  %-6s snapshot  (%s unchanged)" % ("skip", snap["id"]))
    else:
        srows = snapshot_rows(snap)
        for doc, body in srows:
            entry("set", "snapshot", doc, body, "%d bytes" % len(json.dumps(body)) if doc.startswith("p-") else "head of %s" % snap["id"])
        new = set(doc for doc, _ in srows)
        for doc in sorted(have):  # the previous snapshot, written once, so at version 1
            if doc not in new:
                versions.setdefault("snapshot", {})[doc] = versions.get("snapshot", {}).get(doc) or 1
                entry("delete", "snapshot", doc, None, "previous snapshot")

    deviations = [("docs", d["msg"], d["fix"]) for d in snap["deviations"]]
    for mid, row in sorted(rows.get("maps", {}).items()):
        patch, note = map_staleness(row)
        delta = changed(row, patch) if patch else {}
        if delta:
            entry("update", "maps", mid, delta, note)
        else:
            quiet += 1
            if not patch:
                notes.append("  %-6s maps/%s  (%s)" % ("skip", mid, note))
        if (patch or row).get("status") == "stale":
            deviations.append(("stale", "maps/%s: %s" % (mid, note),
                               "refresh the exhibit and re-anchor it, or retire it (arty SKILL.md section 8)"))
    for pid, row in sorted(rows.get("proposals", {}).items()):
        if row.get("status") == "answered":
            deviations.append(("pickup", "proposals/%s answered %r" % (pid, (row.get("answer") or {}).get("choice")),
                               "implement it, ADR it with docky, flip the row to accepted (arty SKILL.md section 5)"))

    with open(synced_path(), "w") as fh:
        json.dump({"digest": docs_digest(root), "snapshot": snap["id"], "at": now()}, fh)
        fh.write("\n")

    # Zero ADRs reads the same as a wrong directory, so say where each count
    # came from and what was passed over.
    for kind, rel in docs_dirs(root).items():
        if not os.path.isdir(os.path.join(root, rel)):
            print("read: %s/ absent (set %s_dir in %s if they live elsewhere)" % (rel, kind, POINTER))
            continue
        inside = [d for d in snap["docs"] if d["path"].startswith(rel + "/")]
        dated = sum(1 for d in inside if d.get("date"))
        skipped = [os.path.basename(d["path"]) for d in inside if not d.get("date")]
        print("read: %s/ %d dated file%s%s" % (
            rel, dated, "" if dated == 1 else "s",
            ", %d shown as plain docs, not named YYYY-MM-DD-HHMM-slug.md: %s%s" % (
                len(skipped), ", ".join(skipped[:4]), ", …" if len(skipped) > 4 else "")
            if skipped else ""))
    print("plan: %d write%s, %d row%s unchanged" % (
        len(plan), "" if len(plan) == 1 else "s", quiet, "" if quiet == 1 else "s"))
    for line in notes:
        print(line)
    print_deviations(deviations)
    batches = split_batches(plan)
    for n, batch in enumerate(batches):
        print("\nbatch %d of %d:" % (n + 1, len(batches)))
        print(json.dumps(batch))


def print_deviations(deviations):
    """The line between routine and judgement: an empty list means the refresh
    is mechanical -- write the batches and stop."""
    if not deviations:
        print("deviations: none -- routine refresh: write the batches in order, nothing else to do")
        return
    print("deviations: %d -- each needs a session's judgement:" % len(deviations))
    for kind, msg, fix in deviations:
        print("  %-7s %s\n          -> %s" % (kind, msg, fix))


BATCH_ENTRIES = 50
BATCH_BYTES = 900 * 1024   # under write_db's 1 MiB per batch


def split_batches(plan):
    """In order, within write_db's limits. Order matters: a snapshot's parts
    land before its head, and the old snapshot goes only after the new head."""
    batches, cur, size = [], [], 0
    for item in plan:
        n = os.path.getsize(item["file_path"]) if item.get("file_path") else 64
        if cur and (len(cur) >= BATCH_ENTRIES or size + n > BATCH_BYTES):
            batches.append(cur)
            cur, size = [], 0
        cur.append(item)
        size += n
    if cur:
        batches.append(cur)
    return batches


def cmd_due(args):
    """Exit 0 and say nothing when the console is current or there is none.

    With --hook, speaks the Claude Code Stop-hook protocol: block once with a
    reason when the repository moved since the last sync, never twice in a row.
    """
    root = git("rev-parse", "--show-toplevel", check=False)
    if not root or not os.path.exists(os.path.join(root, POINTER)):
        return
    os.chdir(root)
    if args.hook:
        try:
            event = json.load(sys.stdin)
        except ValueError:
            event = {}
        if event.get("stop_hook_active"):
            return
    try:
        with open(synced_path()) as fh:
            last = json.load(fh).get("digest")
    except (OSError, ValueError):
        last = None
    if last == docs_digest(root):
        return
    reason = ("The project console (%s) is behind this repository. Routine refresh, no judgement "
              "needed: dump the console, run `arty sync`, write the batches it prints in order "
              "(arty SKILL.md section 6). Act only on the deviations sync lists."
              % read_pointer(root).get("console", ".arty"))
    docs = snap_docs(root)
    found = doc_deviations(root, docs, snap_board(docs, snap_versions()))
    if found:
        reason += " Already visible in docs/: " + "; ".join("%s (%s)" % (d["msg"], d["fix"]) for d in found) + "."
    if args.hook:
        print(json.dumps({"decision": "block", "reason": reason}))
    else:
        print(reason)
        sys.exit(1)


def print_board(board):
    """The board in a terminal: one block per column, Doing first."""
    for col in ("Doing", "Review", "Next", "Backlog"):
        cards = [c for c in board["cards"] if c["column"] == col]
        if not cards:
            continue
        print("%s (%d%s)" % (col.lower(), len(cards), "/%d" % board["wip"] if col == "Doing" else ""))
        for c in cards[:BRIEF_NEXT if col == "Backlog" else len(cards)]:
            label = "".join(" #" + t for t in c["tags"]) + (" +" + c["epic"] if c.get("epic") else "")
            stages = " [%s]" % " > ".join(("*" if x["state"] == "now" else "") + x["name"] + ("✓" if x["state"] == "done" else "")
                                          for x in c["stages"]) if c.get("stages") else ""
            subs = c.get("subtasks", [])
            print("  %s%s%s%s%s%s" % (c["category"] + ": " if c.get("category") else "", c["text"], label, stages,
                                    " (%d/%d)" % (sum(x["done"] for x in subs), len(subs)) if subs else "",
                                    " -- blocked on " + c["blocked"] if c.get("blocked") else ""))
        if col == "Backlog" and len(cards) > BRIEF_NEXT:
            print("  ... %d more" % (len(cards) - BRIEF_NEXT))
    if board["closed"]:
        print("closed (%d in the last %d days)" % (len(board["closed"]), BOARD_CLOSED_DAYS))


def cmd_brief(args):
    """The briefing the console shows, in the terminal: no database needed."""
    root = repo_root()
    os.chdir(root)
    dirs = docs_dirs(root)
    docs = snap_docs(root, dirs)
    commits = snap_commits(SNAP_COMMITS, doc_roots(dirs))
    briefs = snap_briefs(docs, commits, snap_features(commits, snap_refs(default_branch()), default_branch()))
    if not briefs:
        print("no briefing: no changelog under %s/ and no version-commit features" % dirs["changelog"])
    for i, b in enumerate(briefs[:args.n]):
        if i:
            print()
        since = git("rev-list", "--count", "--first-parent", "%s..HEAD" % b["at"], check=False) if b["at"] else "uncommitted"
        print("# %s" % b["title"])
        print("%s%s · %s" % (b.get("date") or "", " " + b["time"] if b.get("time") else "",
                             "at %s, %s commits since" % (b["at"], since) if b["at"] else "uncommitted"))
        print("\n" + b["changed"])
        for a in b["decided"]:
            print("decided  %s -- %s" % (a["title"], a["summary"]))
        for it in b.get("next", []):
            print("next     %s" % it["text"])
        if b.get("next_total", 0) > len(b.get("next", [])):
            print("         ... %d more in docs/TODO.md" % (b["next_total"] - len(b["next"])))
        for it in b.get("blocked", []):
            print("blocked  %s -- on %s" % (it["text"], it["blocked"]))
        for t in b.get("closed", []):
            print("closed   %s" % t)
    board = snap_board(docs, snap_versions())
    if board:
        print()
        print_board(board)
    found = doc_deviations(root, docs, board)
    if found:
        print()
        print_deviations([("docs", d["msg"], d["fix"]) for d in found])


def check_figures(where, row, err):
    """Inline figures: files published beside the console, or https images."""
    figures = row.get("figures")
    if figures is None:
        return
    if not isinstance(figures, list):
        err(where, "figures is not a list")
        return
    for n, fig in enumerate(figures):
        src = fig.get("src") if isinstance(fig, dict) else None
        if not src or not FIGURE_SRC.match(str(src)) or ".." in str(src):
            err(where, "figures[%d].src %r is not a relative path or https url" % (n, src))
    rendering = row.get("figure_rendering")
    if rendering is not None and rendering not in FIGURE_RENDERING:
        err(where, "figure_rendering %r not in %s" % (rendering, "|".join(FIGURE_RENDERING)))


def cmd_check(args):
    root = repo_root()
    os.chdir(root)
    rows, _versions = load_dump(args.db)
    errors, warnings = [], []

    def err(where, msg):
        errors.append("%s: %s" % (where, msg))

    def warn(where, msg):
        warnings.append("%s: %s" % (where, msg))

    meta = rows.get("meta", {}).get("project")
    if not meta:
        err("meta/project", "missing -- run arty init and seed it")
    elif meta.get("schema") != SCHEMA:
        err("meta/project", "schema %r, this arty speaks %d -- run a sync" % (meta.get("schema"), SCHEMA))

    for collection in rows:
        if collection not in KINDS and collection not in ("meta", "snapshot", "records", "briefings"):
            warn(collection, "not a collection this schema knows")

    snap = rows.get("snapshot", {})
    head = latest_head(rows)
    if not head:
        err("snapshot", "no head -- run a sync")
    else:
        for n in range(int(head.get("parts") or 0)):
            if "p-%s-%03d" % (head.get("id"), n) not in snap:
                err("snapshot/p-%s-%03d" % (head.get("id"), n), "missing part of the latest snapshot")
        others = [d for d in snap if not d.endswith(head.get("id")) and not ("-%s-" % head.get("id")) in d]
        if others:
            warn("snapshot", "%d rows from older snapshots -- the next sync deletes them" % len(others))
        if head.get("head") and head["head"] != short(git("rev-parse", "HEAD", check=False)):
            warn("snapshot", "built at %s, HEAD is %s -- run a sync" % (head["head"], git("rev-parse", "--short", "HEAD")))

    seen_urls = {}
    for collection in ("proposals", "maps", "reports"):
        for doc, row in sorted(rows.get(collection, {}).items()):
            where = "%s/%s" % (collection, doc)
            if not ID[collection].match(doc):
                err(where, "id does not match %s" % ID[collection].pattern)
            url = row.get("url")
            if url is not None:
                if not URL.match(str(url)):
                    err(where, "url %r is not an artifact url" % url)
                elif url in seen_urls:
                    err(where, "same exhibit as %s -- one artifact, one row" % seen_urls[url])
                else:
                    seen_urls[url] = where
            for anchor in row.get("anchors", []) or []:
                if not git("ls-files", "--", anchor):
                    warn(where, "anchor %r matches no tracked file" % anchor)

    for doc, row in sorted(rows.get("proposals", {}).items()):
        where = "proposals/%s" % doc
        status = row.get("status")
        if status not in PROPOSAL_STATUS:
            err(where, "status %r not in %s" % (status, "|".join(PROPOSAL_STATUS)))
        for field in ("title", "question", "assumption"):
            if not row.get(field):
                err(where, "no %s" % field)
        if row.get("urgency") not in URGENCY:
            err(where, "urgency %r not in %s" % (row.get("urgency"), "|".join(URGENCY)))
        options = row.get("options") or []
        if status in ("open", "answered") and len(options) < 2:
            err(where, "%d option(s) -- a proposal offers at least two" % len(options))
        keys = [o.get("key") for o in options if isinstance(o, dict)]
        if len(set(keys)) != len(keys):
            err(where, "duplicate option keys")
        if status == "answered":
            choice = (row.get("answer") or {}).get("choice")
            if not choice:
                err(where, "answered with no answer.choice")
            elif choice not in keys:
                err(where, "answer.choice %r is not one of %s" % (choice, keys))
        if status == "accepted" and not (row.get("outcome") or {}).get("adr"):
            warn(where, "accepted without an ADR -- the decision has no durable home")
        if status == "open" and row.get("urgency") == "blocking":
            asked = str(row.get("asked_at", ""))[:10]
            try:
                age = (time.time() - time.mktime(time.strptime(asked, "%Y-%m-%d"))) / 86400
            except ValueError:
                age = 0
            if age > BLOCKING_AGE_DAYS:
                warn(where, "blocking and %d days old" % age)

    for doc, row in sorted(rows.get("maps", {}).items()):
        where = "maps/%s" % doc
        if row.get("status") not in MAP_STATUS:
            err(where, "status %r not in %s" % (row.get("status"), "|".join(MAP_STATUS)))
        for field in ("title", "purpose"):
            if not row.get(field):
                err(where, "no %s" % field)
        if not row.get("url") and not row.get("markdown") and not row.get("figures"):
            err(where, "neither an exhibit url nor inline markdown or figures")
        check_figures(where, row, err)
        if row.get("status") != "retired" and not row.get("anchors"):
            err(where, "no anchors -- nothing to go stale against")
        claims = row.get("claims") or {}
        for key in claims:
            if key not in CLAIM_STATUS:
                err(where, "claims.%s is not one of %s" % (key, "|".join(CLAIM_STATUS)))

    for doc, row in sorted(rows.get("reports", {}).items()):
        where = "reports/%s" % doc
        if row.get("status") not in REPORT_STATUS:
            err(where, "status %r not in %s" % (row.get("status"), "|".join(REPORT_STATUS)))
        for field in ("title", "question"):
            if not row.get(field):
                err(where, "no %s" % field)
        if not row.get("url") and not row.get("markdown") and not row.get("figures"):
            err(where, "neither an exhibit url nor inline markdown or figures")
        check_figures(where, row, err)

    if rows.get("records"):
        warn("records", "%d schema-1 rows left -- a sync deletes them" % len(rows["records"]))
    if rows.get("briefings"):
        warn("briefings", "%d schema-2 rows left -- a sync deletes them" % len(rows["briefings"]))

    live_maps = [d for d, r in rows.get("maps", {}).items() if r.get("status") != "retired"]
    if len(live_maps) > MAX_LIVE_MAPS:
        warn("maps", "%d live -- ceiling is %d; merge or archive" % (len(live_maps), MAX_LIVE_MAPS))
    open_proposals = [d for d, r in rows.get("proposals", {}).items() if r.get("status") == "open"]
    if len(open_proposals) > MAX_OPEN_PROPOSALS:
        warn("proposals", "%d open -- ceiling is %d; the inbox is a queue, not a backlog"
             % (len(open_proposals), MAX_OPEN_PROPOSALS))

    counts = ", ".join("%d %s" % (len(rows.get(k, {})), k) for k in KINDS)
    print("checked: %s" % counts)
    waiting = [d for d, r in rows.get("proposals", {}).items() if r.get("status") == "answered"]
    if waiting:
        print("pickup %d answered proposal%s: %s"
              % (len(waiting), "" if len(waiting) == 1 else "s", ", ".join(sorted(waiting))))
    stale = [d for d, r in rows.get("maps", {}).items() if r.get("status") == "stale"]
    if stale:
        print("stale  %d map%s: %s" % (len(stale), "" if len(stale) == 1 else "s", ", ".join(sorted(stale))))
    for line in warnings:
        print("warn  %s" % line)
    for line in errors:
        print("error %s" % line)
    if errors:
        sys.exit(1)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="arty", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="write the .arty pointer and the meta/project seed")
    p.add_argument("--url", required=True, help="the console artifact's url")
    p.add_argument("--name", help="project name (default: the repository directory)")
    p.add_argument("--seed", help="where to write the meta/project body")
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("page", help="emit the console HTML on stdout")
    p.add_argument("--project", help="name the page (the db still wins once it answers)")
    p.set_defaults(fn=cmd_page)

    p = sub.add_parser("sync", help="snapshot the repository and plan the writes")
    p.add_argument("--db", required=True, help="a read_db out_dir dump of the console")
    p.add_argument("--plan", required=True, help="directory to write the batch bodies into")
    p.add_argument("--force", action="store_true", help="rewrite the snapshot even if unchanged")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("snapshot", help="write the snapshot as one JSON file")
    p.add_argument("--out", required=True, help="where to write it (e.g. beside a local copy of the page)")
    p.set_defaults(fn=cmd_snapshot)

    p = sub.add_parser("brief", help="print the briefing the console shows, from the changelogs and TODO.md")
    p.add_argument("-n", type=int, default=1, help="how many, newest first (default 1)")
    p.set_defaults(fn=cmd_brief)

    p = sub.add_parser("due", help="is the console behind the repository? (exit 1 if so)")
    p.add_argument("--hook", action="store_true", help="speak the Claude Code Stop-hook protocol")
    p.set_defaults(fn=cmd_due)

    p = sub.add_parser("check", help="validate a database dump against the schema")
    p.add_argument("--db", required=True, help="a read_db out_dir dump of the console")
    p.set_defaults(fn=cmd_check)

    args = ap.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
