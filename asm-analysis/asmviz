<script>
"use strict";
(() => {
const $ = (s, r = document) => r.querySelector(s);
const el = (tag, cls, txt) => { const n = document.createElement(tag);
  if (cls) n.className = cls; if (txt != null) n.textContent = txt; return n; };

let B = null, S = null, scope = [], panels = [], units = [], unitIndex = 0;
const sel = { hover: null, pins: [], tags: new Set() };
let lastSignature = "";

// ---- keys. Parsed here and nowhere else (SKILL.md §3).
const dec = s => decodeURIComponent(s);
function parseKey(k) {
  if (typeof k !== "string") return null;
  const p = k.split("|");
  if (p.length !== 6 || p[1] !== "1") return null;
  if (p[0] === "hi") return { space:"hi", variant:dec(p[2]), unit:dec(p[3]), file:dec(p[4]), line:dec(p[5]) };
  if (p[0] === "lo") return { space:"lo", kind:dec(p[2]), variant:dec(p[3]), artifact:dec(p[4]), address:dec(p[5]) };
  if (p[0] === "ct") return { space:"ct", variant:dec(p[2]), artifact:dec(p[3]) };
  return null;
}
const enc = s => (s == null ? "-" : String(s).replace(/%/g, "%25").replace(/\|/g, "%7C") || "-");
// Internable fields (SKILL.md §4) hold a literal string or an index into B.strings.
const str = (table, v) => (typeof v === "number"
  ? (((B.strings || {})[table] || [])[v] ?? null) : v);
const frameFile = f => str("file", f.file);
const frameFn = f => f.displayFunction || str("function", f.function);
const rowText = r => str("text", r.text) || "";
const highKey = (v, u, f, l) => ["hi","1",enc(v),enc(u),enc(f),enc(l)].join("|");
function project(key) {
  const f = parseKey(key); if (!f || f.space !== "hi") return null;
  return scope.map(c => enc(f[c])).join("|");
}

// ---- token families. Coloured only when the bundle declares them: a fixed table,
// never encounter order, so a token keeps its colour across panels and rebuilds.
let FAM = null;
function buildFamilies() {
  const tf = (B.corpus && B.corpus.tokenFamilies) || null;
  if (!tf || !tf.order || !tf.order.length) return null;
  const order = tf.order, aliases = tf.aliases || {}, classes = tf.classes || {};
  const CH = { gpr:.155, mask:.105, vec:.13, addr:.07, other:.12 };
  const n = order.length;
  // Over a known, small set divide the circle evenly on a stride coprime with n;
  // the golden angle leaves visible collisions at small n.
  let stride = Math.max(1, Math.round(n * 0.375)) | 1;
  while (n > 1 && gcd(stride, n) !== 1) stride++;
  const hue = {}; order.forEach((name, i) => { hue[name] = (i * stride * (360 / n)) % 360; });
  const re = new RegExp("\\b(" + Object.keys(aliases).concat(order)
    .sort((a, b) => b.length - a.length).map(esc).join("|") + ")\\b", "g");
  return { re, canon: t => aliases[t] || t, hue, chroma: t => CH[classes[t] || "other"] || CH.other };
}
const gcd = (a, b) => b ? gcd(b, a % b) : a;
const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

function renderText(text) {
  const span = el("span", "txt");
  if (!FAM) { span.textContent = text; return span; }
  let last = 0; FAM.re.lastIndex = 0; let m;
  while ((m = FAM.re.exec(text))) {
    if (m.index > last) span.appendChild(document.createTextNode(text.slice(last, m.index)));
    const fam = FAM.canon(m[0]);
    const t = el("span", "tok", m[0]);
    t.style.setProperty("--th", String(FAM.hue[fam] ?? 0));
    t.style.setProperty("--tc", String(FAM.chroma(fam)));
    t.title = m[0] + " · " + fam;
    span.appendChild(t); last = m.index + m[0].length;
  }
  span.appendChild(document.createTextNode(text.slice(last)));
  return span;
}

// ---- virtual row model. Markers occupy row slots in the same model as rows, so
// instruction index != row index. Always translate (SKILL.md §7).
function rowModel(container) {
  if (container.__model) return container.__model;
  const rows = container.rows || [], regions = (container.regions || []).slice()
    .sort((a, b) => (a.startRow - b.startRow) || (a.level - b.level));
  const virt = [], instRow = new Map();
  virt.push({ t: "begin", c: container });
  let ri = 0;
  for (let i = 0; i < rows.length; i++) {
    while (ri < regions.length && regions[ri].startRow === i) virt.push({ t: "region", r: regions[ri++] });
    instRow.set(i, virt.length);
    virt.push({ t: "inst", i, row: rows[i] });
  }
  virt.push({ t: "end", c: container });
  container.__model = { virt, instRow };
  return container.__model;
}

// ---- indexes: high key -> low rows, low row -> high keys, per panel.
function buildIndexes(p) {
  const byHigh = new Map(), byProj = new Map();
  for (const c of p.containers) {
    const m = rowModel(c);
    (c.rows || []).forEach((r, i) => {
      for (const f of r.frames || []) {
        if (!f.key) continue;
        if (!byHigh.has(f.key)) byHigh.set(f.key, []);
        byHigh.get(f.key).push({ c, i, v: m.instRow.get(i) });
        const pj = project(f.key);
        if (pj) { if (!byProj.has(pj)) byProj.set(pj, []); byProj.get(pj).push({ c, i, v: m.instRow.get(i) }); }
      }
    });
  }
  p.byHigh = byHigh; p.byProj = byProj;
}

function equivalenceOf(key) {
  const out = new Set([key]);
  for (const g of (S.equivalences || [])) if (g.includes(key)) g.forEach(k => out.add(k));
  return out;
}
function expand(keys) {
  const seeds = new Set(), all = new Set();
  for (const k of keys) { seeds.add(k); equivalenceOf(k).forEach(x => all.add(x)); }
  const proj = new Set();
  for (const k of all) { const p = project(k); if (p) proj.add(p); }
  return { seeds, all, proj };
}

// ---- panels
function build() {
  const grid = $("#grid");
  grid.style.setProperty("--column-count", String(B.variants.length));
  grid.textContent = "";
  grid.appendChild(Object.assign(el("div", "band hi"), { textContent: "source" }));
  grid.appendChild(Object.assign(el("div", "band lo"), { textContent: "generated" }));

  const order = B.variants.slice().sort((a, b) => (a.order || 0) - (b.order || 0));
  panels = order.map(v => {
    const host = el("div", "host");
    const hi = el("div", "panel hi"), lo = el("div", "panel lo");
    const p = { v, hi, lo, containers: (B.containers || []).filter(c => c.variant === v.id) };
    p.container = pickContainer(p);
    for (const [node, kind] of [[hi, "hi"], [lo, "lo"]]) {
      const head = el("div", "head");
      head.appendChild(el("b", null, v.label || v.id));
      head.appendChild(el("span", null, kind === "hi"
        ? (v.sourceRev ? "@" + v.sourceRev : "") + (v.sourceDirty ? " +dirty" : "")
        : (v.compiler || "")));
      const count = el("span", "count"); head.appendChild(count);
      const body = el("div", "body"), rail = el("div", "rail");
      node.append(head, body, rail);
      if (kind === "hi") { p.hiBody = body; p.hiRail = rail; p.hiCount = count; }
      else { p.loBody = body; p.loRail = rail; p.loCount = count; }
    }
    host.append(hi, lo); grid.appendChild(host);
    buildIndexes(p);
    return p;
  });
  panels.forEach(renderHigh);
  panels.forEach(p => { p.loBody.addEventListener("scroll", () => paintLow(p)); renderLow(p); });
}

function pickContainer(p) {
  const withUnit = p.containers.filter(c => Object.keys(c.unitOccurrences || {}).length);
  const pool = withUnit.length ? withUnit : p.containers;
  return pool.slice().sort((a, b) =>
    (b.observedCount || 0) - (a.observedCount || 0) ||
    (b.rows || []).length - (a.rows || []).length)[0] || null;
}

// High panels are not virtualized: real measured offsets are needed for the rail
// because source rows wrap.
function renderHigh(p) {
  const body = p.hiBody; body.textContent = "";
  const files = (B.sources || {})[p.v.id] || {};
  const names = Object.keys(files).sort();
  let shown = 0;
  p.hiRows = new Map();
  for (const name of names) {
    const f = files[name];
    const hdr = el("div", "filehdr");
    hdr.appendChild(el("b", null, name));
    if (!f.available) {
      hdr.appendChild(el("span", null, "source not available"));
      body.appendChild(hdr); continue;
    }
    const lines = f.lines || [];
    const relevant = new Set(lines.filter(l => l.relevant).map(l => l.n));
    if (!relevant.size) continue;
    const ctx = (B.corpus && B.corpus.contextLines) || 3;
    const keep = new Set();
    for (const n of relevant) for (let d = -ctx; d <= ctx; d++) keep.add(n + d);
    hdr.appendChild(el("span", null, relevant.size + " relevant / " + (f.lineCount || lines.length) + " lines"));
    body.appendChild(hdr);
    let prev = null;
    for (const line of lines) {
      if (!keep.has(line.n)) { prev = null; continue; }
      if (prev != null && line.n !== prev + 1) body.appendChild(el("div", "marker", "…"));
      prev = line.n;
      const row = el("div", "row" + (relevant.has(line.n) ? "" : " context"));
      row.appendChild(el("div", "n", String(line.n)));
      row.appendChild(el("div", "src", line.text));
      const unit = unitFor(p, name, line.n);
      const key = highKey(p.v.id, unit, name, line.n);
      row.dataset.key = key;
      row.addEventListener("pointerenter", () => setHover(key));
      row.addEventListener("pointerleave", () => setHover(null));
      row.addEventListener("click", () => togglePin(key));
      body.appendChild(row);
      if (!p.hiRows.has(key)) p.hiRows.set(key, []);
      p.hiRows.get(key).push(row);
      shown++;
    }
  }
  if (!shown) body.appendChild(el("div", "empty", "no source rows for this variant"));
  p.hiCount.textContent = shown + " rows";
}

function unitFor(p, file, line) {
  for (const u of B.units || []) {
    const r = (u.realizations || {})[p.v.id];
    if (r && r.status === "present" && r.file === file &&
        line >= (r.startLine || 0) && line <= (r.stopLine || 0)) return u.id;
  }
  return "-";
}

// Low panels are virtualized: matches scrolled out of the window have no DOM node,
// which is why highlighting is written against the model, not the DOM.
function renderLow(p) {
  const body = p.loBody; body.textContent = "";
  if (!p.container) { body.appendChild(el("div", "empty", "no container")); p.loCount.textContent = ""; return; }
  const m = rowModel(p.container);
  p.spacer = el("div");
  p.spacer.style.height = (m.virt.length * rowHeight()) + "px";
  p.spacer.style.position = "relative";
  body.appendChild(p.spacer);
  p.loCount.textContent = (p.container.rows || []).length + " rows · " +
    (p.container.displayName || p.container.name || "");
  paintLow(p);
}

function rowHeight() {
  // One source of truth: the stylesheet. Two copies drift.
  return parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--row-height")) || 22;
}

function paintLow(p) {
  if (!p.container) return;
  const m = rowModel(p.container), H = rowHeight(), OVER = 20;
  const top = Math.max(0, Math.floor(p.loBody.scrollTop / H) - OVER);
  const bot = Math.min(m.virt.length, Math.ceil((p.loBody.scrollTop + p.loBody.clientHeight) / H) + OVER);
  p.spacer.textContent = "";
  p.loRowNodes = new Map();
  const artifact = p.v.artifactHash;
  for (let i = top; i < bot; i++) {
    const item = m.virt[i];
    const node = el("div", item.t === "inst" ? "row" : "marker");
    node.style.position = "absolute";
    node.style.top = (i * H) + "px";
    node.style.left = "0"; node.style.right = "0";
    if (item.t === "begin") node.textContent = "▸ " + (p.container.displayName || p.container.name || "") +
      "  " + (p.container.start || "") + "–" + (p.container.stop || "");
    else if (item.t === "end") node.textContent = "▴ end";
    else if (item.t === "region") {
      const r = item.r;
      node.textContent = "  ".repeat(Math.max(0, r.level)) + "inline · " +
        (r.displayFunction || r.function || "") +
        (r.atFile ? " @ " + r.atFile + ":" + r.atLine : "") +
        (r.calledAtFile ? " · called at " + r.calledAtFile + ":" + r.calledAtLine : "") +
        (r.fragment ? " · fragment " + r.fragment[0] + "/" + r.fragment[1] : "");
    } else {
      const row = item.row;
      const key = row.key || ["lo","1",enc("asm"),enc(p.v.id),enc(artifact),enc(row.address)].join("|");
      const gut = el("div", "gut");
      if (row.observed && row.observed.executions) {
        const o = Math.min(1, Math.max(.22, Math.log2(row.observed.executions + 1) / 12));
        gut.style.background = "var(--group)"; gut.style.opacity = String(o);
      }
      node.appendChild(gut);
      node.appendChild(el("div", "n", row.address || ""));
      node.appendChild(renderText(rowText(row)));
      node.dataset.key = key;
      node.tabIndex = 0;
      node.setAttribute("aria-label", (row.address || "") + " " + rowText(row));
      node.title = (row.frames || []).map((f, d) =>
        "  ".repeat(d) + (frameFn(f) || "?") +
        (frameFile(f) ? " @ " + frameFile(f) + ":" + f.line : "") +
        (f.physical ? "  [physical]" : "")).join("\n");
      const seeds = (row.frames || []).map(f => f.key).filter(Boolean);
      node.addEventListener("pointerenter", () => setHover(preferred(seeds, p)));
      node.addEventListener("pointerleave", () => setHover(null));
      node.addEventListener("click", () => togglePin(preferred(seeds, p)));
      node.addEventListener("dblclick", () => openNote(key, row));
      p.loRowNodes.set(key, node);
      if (S.notes && S.notes[key]) node.classList.add("noted");
    }
    p.spacer.appendChild(node);
  }
  applyClasses();
}

// Prefer the unit currently being viewed; expanding every frame across columns makes
// the hovered column dominate (SKILL.md §7).
function preferred(seeds, p) {
  if (!seeds.length) return null;
  const want = units[unitIndex] && units[unitIndex].id;
  return seeds.find(k => { const f = parseKey(k); return f && f.unit === want; }) || seeds[0];
}

// ---- selection. Holds keys, never DOM nodes; mutates classes in place and never
// re-renders, because repainting under the pointer fires pointerleave.
function setHover(key) { sel.hover = key; applyClasses(); }
function togglePin(key) {
  if (!key) return;
  const i = sel.pins.indexOf(key);
  if (i >= 0) sel.pins.splice(i, 1);           // clicking a partner ADDS it
  else { sel.pins.push(key); if (sel.pins.length > 7) sel.pins.shift(); }
  applyClasses();
}

function applyClasses() {
  const hov = sel.hover ? expand([sel.hover]) : null;
  const pin = sel.pins.length ? expand(sel.pins) : null;
  const tags = sel.tags;
  const tagRows = new Map();
  if (tags.size) for (const [k, ids] of Object.entries(S.lineTags || {}))
    if (ids.some(t => tags.has(String(t)))) tagRows.set(k, ids);

  for (const p of panels) {
    for (const [key, nodes] of p.hiRows) {
      const pj = project(key);
      for (const n of nodes) {
        n.classList.toggle("link", !!hov && (hov.all.has(key) || (pj && hov.proj.has(pj))));
        n.classList.toggle("pin", !!pin && pin.seeds.has(key));
        const partner = !!pin && !pin.seeds.has(key) && (pin.all.has(key) || (pj && pin.proj.has(pj)));
        n.classList.toggle("group", partner);
        n.classList.toggle("partner", partner);
      }
    }
    if (!p.loRowNodes) continue;
    for (const [key, node] of p.loRowNodes) {
      const keys = keysOf(p, key);
      const hit = set => keys.some(k => set.all.has(k) || (project(k) && set.proj.has(project(k))));
      node.classList.toggle("link", !!hov && hit(hov));
      node.classList.toggle("pin", !!pin && hit(pin));
      node.classList.toggle("stack", !!hov && sel.hover != null &&
        keys.includes(sel.hover) === false && hov.seeds.size > 0 &&
        keys.some(k => { const a = parseKey(k), b = parseKey(sel.hover);
                         return a && b && a.variant === b.variant && hov.all.has(k); }));
      const ids = tagRows.get(key);
      node.classList.toggle("tagged", !!ids);
      if (ids) {
        const t = (S.tags || []).find(x => String(x.id) === String(ids[0]));
        if (t && t.color) node.style.setProperty("--tag-color", t.color);
      }
    }
  }
  const sig = (sel.hover || "") + "|" + sel.pins.join(",") + "|" + [...tags].join(",");
  if (sig !== lastSignature) { lastSignature = sig; paintRails(hov, pin, tagRows); updateStatus(); }
}

function keysOf(p, lowKey) {
  const node = p.loRowNodes.get(lowKey);
  if (!node) return [];
  if (node.__keys) return node.__keys;
  const m = rowModel(p.container);
  const idx = [...m.instRow.keys()].find(i => {
    const r = p.container.rows[i];
    return r && (r.key === lowKey || enc(r.address) === parseKey(lowKey)?.address);
  });
  const row = idx != null ? p.container.rows[idx] : null;
  node.__keys = row ? (row.frames || []).map(f => f.key).filter(Boolean) : [];
  return node.__keys;
}

// Rails: positions are fractions of scroll range, so a match with no DOM node is
// still locatable. Merge adjacent marks only within one colour.
function paintRails(hov, pin, tagRows) {
  for (const p of panels) {
    p.hiRail.textContent = ""; p.loRail.textContent = "";
    if (p.container) {
      const m = rowModel(p.container), total = m.virt.length;
      const marks = [];
      for (const [key, hits] of p.byHigh) {
        const inHov = hov && hov.all.has(key), inPin = pin && pin.all.has(key);
        if (!inHov && !inPin) continue;
        for (const h of hits) if (h.c === p.container)
          marks.push({ f: h.v / total, cls: inPin ? "pin" : "link" });
      }
      for (const mk of marks) {
        const n = el("div", "rail-mark c");
        n.style.top = (mk.f * 100) + "%";
        n.style.background = mk.cls === "pin" ? "var(--pinned)" : "var(--linked)";
        p.loRail.appendChild(n);
      }
      if (tagRows.size) {
        (p.container.rows || []).forEach((r, i) => {
          const key = r.key; if (!key || !tagRows.has(key)) return;
          const n = el("div", "rail-mark t");
          n.style.top = ((m.instRow.get(i) / total) * 100) + "%";
          n.style.background = "var(--group)";
          p.loRail.appendChild(n);
        });
      }
      p.loRail.onclick = ev => {
        const f = ev.offsetY / p.loRail.clientHeight;
        p.loBody.scrollTop = f * p.spacer.offsetHeight - p.loBody.clientHeight / 2;
      };
    }
    const h = p.hiBody.scrollHeight || 1;
    for (const [key, nodes] of p.hiRows) {
      const inHov = hov && (hov.all.has(key) || hov.proj.has(project(key)));
      const inPin = pin && (pin.all.has(key) || pin.proj.has(project(key)));
      if (!inHov && !inPin) continue;
      for (const n of nodes) {
        const mk = el("div", "rail-mark c");
        mk.style.top = ((n.offsetTop / h) * 100) + "%";
        mk.style.background = inPin ? "var(--pinned)" : "var(--linked)";
        p.hiRail.appendChild(mk);
      }
    }
    p.hiRail.onclick = ev => {
      const f = ev.offsetY / p.hiRail.clientHeight;
      p.hiBody.scrollTop = f * p.hiBody.scrollHeight - p.hiBody.clientHeight / 2;
    };
  }
}

function updateStatus() {
  const bits = panels.map(p => (p.v.label || p.v.id) + " " +
    ((p.container && (p.container.rows || []).length) || 0));
  $("#status").textContent = bits.join(" · ") +
    (sel.pins.length ? "  · " + sel.pins.length + " pinned" : "") +
    (sel.tags.size ? "  · " + sel.tags.size + " tag(s)" : "") +
    (S.writable ? "" : "  · read-only");
}

// ---- navigation
function gotoUnit(i) {
  if (!units.length) return;
  unitIndex = (i + units.length) % units.length;
  const u = units[unitIndex];
  $("#unit").value = u.id;
  for (const p of panels) {
    const r = (u.realizations || {})[p.v.id];
    const target = p.containers.find(c => (c.unitOccurrences || {})[u.id]) || p.container;
    if (target && target !== p.container) { p.container = target; renderLow(p); }
    const occ = p.container && (p.container.unitOccurrences || {})[u.id];
    if (occ && occ.length) {
      const m = rowModel(p.container);
      const v = m.instRow.get(occ[0].startIndex) || 0;
      p.loBody.scrollTop = Math.max(0, v * rowHeight() - p.loBody.clientHeight * 0.38);
    }
    if (r && r.status === "present" && r.startLine) {
      for (const [key, nodes] of p.hiRows) {
        const f = parseKey(key);
        if (f && f.file === r.file && Number(f.line) === r.startLine && nodes[0]) {
          p.hiBody.scrollTop = Math.max(0, nodes[0].offsetTop - p.hiBody.clientHeight * 0.3);
          break;
        }
      }
    }
  }
  updateStatus();
}

// ---- notes
let noteKey = null;
function openNote(key, row) {
  if (!S.writable) return;
  noteKey = key;
  $("#noteaddr").textContent = (row.address || "") + "   " + rowText(row);
  $("#note").value = (S.notes && S.notes[key]) || "";
  $("#notedlg").showModal();
}
$("#notesave").addEventListener("click", async () => {
  const body = $("#note").value;
  const res = await fetch("/api/note", { method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ key: noteKey, body }) }).then(r => r.json());
  if (res.ok) { S = res.state; panels.forEach(paintLow); }
});

// ---- tags
function openTags() {
  const list = $("#taglist"); list.textContent = "";
  for (const t of S.tags || []) {
    const row = el("label", null);
    row.style.display = "flex"; row.style.gap = "8px"; row.style.padding = "3px 0";
    const cb = el("input"); cb.type = "checkbox"; cb.checked = sel.tags.has(String(t.id));
    cb.addEventListener("change", () => {
      cb.checked ? sel.tags.add(String(t.id)) : sel.tags.delete(String(t.id));
      $("#tagbtn").setAttribute("aria-pressed", String(sel.tags.size > 0));
      applyClasses();
    });
    const dot = el("span", "dot"); dot.style.background = t.color || "var(--muted)";
    row.append(cb, dot, el("span", null, t.label || t.id));
    list.appendChild(row);
  }
  if (!(S.tags || []).length) list.appendChild(el("div", "empty", "no tags in the store"));
  $("#tagdlg").showModal();
}

// ---- boot
async function boot() {
  B = await fetch("/bundle.json").then(r => r.json());
  S = await fetch("/api/state").then(r => r.json());
  const declared = B.corpus && B.corpus.variantCount;
  if (declared != null && declared !== (B.variants || []).length)
    throw new Error("bundle declares " + declared + " variants but carries " + B.variants.length);
  scope = ((B.corpus || {}).correspondence || {}).autoLink || ["variant", "unit", "file", "line"];
  FAM = buildFamilies();
  units = (B.units || []).slice().sort((a, b) => (a.order || 0) - (b.order || 0));
  const usel = $("#unit");
  for (const u of units) usel.appendChild(Object.assign(el("option", null, u.title || u.id), { value: u.id }));
  usel.addEventListener("change", () => gotoUnit(units.findIndex(u => u.id === usel.value)));
  build();
  if (units.length) gotoUnit(0);
  updateStatus();
  $("#prev").onclick = () => gotoUnit(unitIndex - 1);
  $("#next").onclick = () => gotoUnit(unitIndex + 1);
  $("#clear").onclick = () => { sel.pins = []; sel.tags.clear();
    $("#tagbtn").setAttribute("aria-pressed", "false"); applyClasses(); };
  $("#tagbtn").onclick = openTags;
  $("#theme").onclick = () => {
    const cur = document.documentElement.getAttribute("data-theme");
    document.documentElement.setAttribute("data-theme", cur === "light" ? "dark" : "light");
  };
  addEventListener("keydown", ev => {
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(ev.target.tagName) || document.querySelector("dialog[open]")) return;
    if (ev.key === "ArrowDown") { gotoUnit(unitIndex + 1); ev.preventDefault(); }
    else if (ev.key === "ArrowUp") { gotoUnit(unitIndex - 1); ev.preventDefault(); }
    else if (ev.key === "Escape") $("#clear").click();
    else if (ev.key === "t" || ev.key === "T") openTags();
  });
}
boot().catch(err => { $("#status").textContent = "error: " + err.message; throw err; });
})();
</script>
</body>
</html>
